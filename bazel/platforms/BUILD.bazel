load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")

package(
    default_visibility = PACKAGE_DEFAULT_VISIBILITY,
)

# Execution platforms with dedicated cache silo keys for remote caching / RBE.
#
# We define distinct platform targets rather than configuring `cache-silo-key`
# via `--remote_default_exec_properties` in `.bazelrc` because Bazel's options
# parser collects `--remote_default_exec_properties` into an ImmutableMap.
# If a chained config (e.g. `wheel_nightly` -> `wheel_common`) or multiple CLI
# flags specify `--remote_default_exec_properties=cache-silo-key=...`, Bazel
# crashes with a duplicate-key IllegalArgumentException during execution.
# See https://github.com/bazelbuild/bazel/issues/29552 (fixed in Bazel 9.2).
#
# Setting `cache-silo-key` on platform targets and prepending them via
# `--extra_execution_platforms` allows clean, conflict-free silo key selection
# across different build pipelines.

# Default platform cache silo key for standard readonly RBE caching.
platform(
    name = "rbe_default_platform",
    exec_properties = {
        "cache-silo-key": "FirstCachedBuild",
    },
    parents = ["@ml_build_config_platform//:platform"],
    visibility = ["//visibility:public"],
)

# Isolates nightly wheel build artifacts from PR builds and release builds.
platform(
    name = "rbe_wheel_nightly_platform",
    exec_properties = {
        "cache-silo-key": "wheel-nightly",
    },
    parents = ["@ml_build_config_platform//:platform"],
    visibility = ["//visibility:public"],
)

# Isolates release wheel build artifacts from nightly builds and dev snapshots.
platform(
    name = "rbe_wheel_release_platform",
    exec_properties = {
        "cache-silo-key": "wheel-release",
    },
    parents = ["@ml_build_config_platform//:platform"],
    visibility = ["//visibility:public"],
)

# Splits a native Buildbarn build across two worker pools: compiles, links and
# genrules run on the x86 CPU pool, test runner actions run on the TPU v5e pool.
#
# Unprefixed properties apply to every action. The `test.` prefix scopes a
# property to Bazel's built-in `test` execution group, so only the test runner
# action asks for an accelerator. See
# https://bazel.build/extending/exec-groups#exec-groups-for-native-rules.
#
# Two things here are deliberate and easy to get wrong:
#   - No `parents`. Buildbarn's scheduler keys its worker queues on the exact
#     set of platform properties, so inheriting the `cache-silo-key` from
#     `@ml_build_config_platform//:platform` would leave every action matching
#     no pool at all. The constraints are listed directly instead.
#   - `test.OSFamily` repeats the default-group value rather than relying on
#     the two maps being merged, for the same exact-match reason.
platform(
    name = "buildbarn_native_tpu_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "test.Accelerator": "tpu-v5e",
        "test.OSFamily": "Linux",
    },
    visibility = ["//visibility:public"],
)
