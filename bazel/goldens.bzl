"""Repository rule that fetches the ops_test GPU golden files pinned by goldens.pin.

The repository exports each golden file individually, so an ops test lists exactly the files it
needs in `data` (e.g. `@torch_tpu_goldens//:ops_test_gpu_golden0.gz`), identical to how the same
test depends on the files in Google3, except that the files are fetched from GCS instead of being
read from the source tree.
"""

_SUPPORTED_PIN_VERSION = 1

_BUILD_TEMPLATE = """\
# Generated by //bazel:goldens.bzl from {pin_file}. Do not edit.

package(default_visibility = ["//visibility:public"])

exports_files([
{files}
])
"""

def _goldens_repo_impl(rctx):
    pin_path = rctx.path(rctx.attr.pin_file)
    pin = json.decode(rctx.read(pin_path))

    version = pin.get("version")
    if version != _SUPPORTED_PIN_VERSION:
        fail("{}: unsupported goldens.pin version {}, expected {}".format(
            pin_path,
            version,
            _SUPPORTED_PIN_VERSION,
        ))
    bucket = pin.get("gcs_bucket")
    if not bucket:
        fail("{}: missing 'gcs_bucket'".format(pin_path))
    goldens = pin.get("goldens")
    if not goldens:
        fail("{}: 'goldens' must be a non-empty object".format(pin_path))

    for filename in sorted(goldens):
        entry = goldens[filename]
        if not entry.get("gcs_path"):
            fail("{}: {} is missing 'gcs_path'".format(pin_path, filename))
        if not entry.get("sha256"):
            fail("{}: {} is missing 'sha256'".format(pin_path, filename))

    # Start every download without blocking so they run concurrently, then wait on each one.
    pending = [
        rctx.download(
            url = "https://storage.googleapis.com/{}/{}".format(
                bucket,
                goldens[filename]["gcs_path"],
            ),
            output = filename,
            sha256 = goldens[filename]["sha256"],
            block = False,
        )
        for filename in goldens
    ]
    for download in pending:
        download.wait()

    rctx.file(
        "BUILD.bazel",
        content = _BUILD_TEMPLATE.format(
            pin_file = rctx.attr.pin_file,
            files = "\n".join([
                '    "{}",'.format(filename)
                for filename in sorted(goldens)
            ]),
        ),
        executable = False,
    )

goldens_repo = repository_rule(
    implementation = _goldens_repo_impl,
    attrs = {
        "pin_file": attr.label(
            allow_single_file = True,
            mandatory = True,
            doc = "The goldens.pin manifest listing the files to fetch.",
        ),
    },
    doc = "Fetches the GPU golden files listed in a goldens.pin manifest.",
)
