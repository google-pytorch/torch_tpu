"""Repository rule for mounting an external PyTorch test/ directory in OSS.

Exposes per-test-module filegroups (`:<module_slug>_module`) and per-subsystem
support filegroups (`:<subdir>_support`) so each `torch_tpu_torch_test` target
depends only on its own upstream test module and imported helpers:
  1. When `TORCH_SOURCE` (e.g. the daily PyTorch nightly wheel) is held fixed,
     modifying a `test/**/test_*.py` file in upstream `pytorch/pytorch`
     invalidates only the corresponding `//tests/torch:<target>` Bazel test
     action (plus any target explicitly importing that file as a helper) while
     preserving remote test cache hits for all unrelated targets.
  2. Staging the test module and helpers as declared `data` runfiles makes
     `//tests/torch:all` hermetically runnable on RBE (`rbe_test_execution`).
  3. When `TORCH_TPU_INTERNAL_PYTORCH_TEST_DIR` is unset (e.g. during CPU
     presubmit `bazel cquery //...`), all generated `glob(..., allow_empty = True)`
     filegroups evaluate to empty lists so target analysis succeeds without a
     local PyTorch checkout.
"""

_TESTS_TORCH_BUILD = Label("//tests/torch:BUILD")

# Test modules that import specific `test_*.py` or data files outside their own
# non-`test_*.py` directory support files. Scoping shared `test_*.py` helpers to
# their actual importers keeps frequent edits (such as `test_torchinductor.py`)
# from invalidating independent modules in the same subdirectory.
_EXTRA_MODULE_GLOBS = {
    "dynamo/test_ctx_manager": ["test/dynamo/test_functions.py"],
    "dynamo/test_modules": ["test/dynamo/test_functions.py"],
    "dynamo/test_repros": ["test/dynamo/test_tokenization.py"],
    "dynamo/test_tp_richcompare": ["test/test_opaque_obj_v2.py"],
    "higher_order_ops/test_invoke_subgraph": ["test/test_opaque_obj_v2.py"],
    "inductor/test_compiled_optimizers": ["test/inductor/test_torchinductor.py"],
    "inductor/test_torchinductor_codegen_dynamic_shapes": [
        "test/inductor/test_torchinductor.py",
        "test/inductor/test_torchinductor_dynamic_shapes.py",
    ],
    "inductor/test_torchinductor_dynamic_shapes": [
        "test/inductor/test_torchinductor.py",
    ],
    "inductor/test_torchinductor_opinfo": [
        "test/inductor/test_torchinductor.py",
    ],
    "inductor/test_torchinductor_opinfo_properties": [
        "test/inductor/test_torchinductor.py",
    ],
    "test_ao_sparsity": ["test/ao/**"],
    "test_autograd": ["test/autograd/**"],
    "test_custom_ops": ["test/minioptest_failures_dict.json"],
    "test_optim": ["test/optim/**"],
}

# Cross-subsystem support targets needed by specific test modules.
_EXTRA_MODULE_SUPPORT_TARGETS = {
    "dynamo/test_after_aot": [":inductor_support"],
}

_BUILD_HEADER = """\
# Generated by //bazel:pytorch_test_repo.bzl. Do not edit.

package(default_visibility = ["//visibility:public"])
"""

_SUBDIR_SUPPORT_TEMPLATE = """
filegroup(
    name = "{subdir}_support",
    srcs = glob(
        ["test/{subdir}/**"],
        exclude = [
            "test/{subdir}/**/.*",
            "test/{subdir}/**/test_*.py",
        ],
        allow_empty = True,
    ),
)
"""

_MODULE_FILEGROUP_TEMPLATE = """
filegroup(
    name = "{target_name}",
    srcs = glob(
        {patterns},
        allow_empty = True,
    ){extra_targets_expr},
)
"""

def _extract_test_modules(build_content):
    """Extracts `torch_test_module` values from `//tests/torch:BUILD`."""
    modules = []
    prefix = 'torch_test_module = "'
    for line in build_content.splitlines():
        trimmed = line.strip()
        if trimmed.startswith(prefix) and trimmed.endswith('",'):
            modules.append(trimmed[len(prefix):-2])
    return modules

def _pytorch_test_repo_impl(rctx):
    build_content = rctx.read(rctx.path(_TESTS_TORCH_BUILD))
    modules = _extract_test_modules(build_content)

    test_dir = rctx.getenv("TORCH_TPU_INTERNAL_PYTORCH_TEST_DIR", "")
    if test_dir and rctx.path(test_dir).exists:
        marker_path = rctx.path(test_dir + "/.pytorch_test_tree")
        if marker_path.exists:
            rctx.read(marker_path)
        resolved_test_dir = str(rctx.path(test_dir))
        rctx.execute(["mkdir", "-p", "test"])
        rctx.execute(["cp", "-as", resolved_test_dir + "/.", "test/"])
        rctx.execute(["rm", "-f", "test/.pytorch_test_tree"])
        rctx.execute([
            "find",
            "test",
            "(",
            "-name",
            "BUILD",
            "-o",
            "-name",
            "BUILD.bazel",
            ")",
            "-delete",
        ])

    subdirs = {
        module.split("/", 1)[0]: True
        for module in modules
        if "/" in module
    }
    for extra_targets in _EXTRA_MODULE_SUPPORT_TARGETS.values():
        for label in extra_targets:
            if label.startswith(":") and label.endswith("_support"):
                subdirs[label[1:-len("_support")]] = True

    blocks = [_BUILD_HEADER]
    for subdir in sorted(subdirs.keys()):
        blocks.append(
            _SUBDIR_SUPPORT_TEMPLATE.format(subdir = subdir),
        )

    for module in modules:
        target_name = module.replace("/", "_") + "_module"
        patterns = ["test/{}.py".format(module)] + _EXTRA_MODULE_GLOBS.get(
            module,
            [],
        )
        support_targets = []
        if "/" in module:
            support_targets.append(":{}_support".format(module.split("/", 1)[0]))
        for extra_target in _EXTRA_MODULE_SUPPORT_TARGETS.get(module, []):
            if extra_target not in support_targets:
                support_targets.append(extra_target)
        extra_targets_expr = (
            " + " + repr(support_targets) if support_targets else ""
        )
        blocks.append(
            _MODULE_FILEGROUP_TEMPLATE.format(
                target_name = target_name,
                patterns = repr(patterns),
                extra_targets_expr = extra_targets_expr,
            ),
        )

    rctx.file(
        "BUILD.bazel",
        content = "".join(blocks),
        executable = False,
    )

pytorch_test_repo = repository_rule(
    implementation = _pytorch_test_repo_impl,
    environ = ["TORCH_TPU_INTERNAL_PYTORCH_TEST_DIR"],
    local = True,
    doc = (
        "Mounts the PyTorch test/ checkout pointed to by " +
        "TORCH_TPU_INTERNAL_PYTORCH_TEST_DIR as per-module filegroups."
    ),
)
