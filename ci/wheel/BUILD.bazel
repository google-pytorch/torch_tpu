load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("@rules_python//python:py_test.bzl", "py_test")
load("@torch_tpu_deps//:dependencies.bzl", "WHEEL_REQUIRES")
load("@torch_tpu_version//:version.bzl", "WHEEL_VERSION")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")
load("//build_files:entry_points.bzl", "ENTRY_POINTS")
load("//ci/wheel:pywrap_mapper.bzl", "remap_pywrap_binaries")
load("//shims/py_rules:pytype.bzl", "pytype_strict_binary", "pytype_strict_library")

package(
    default_visibility = PACKAGE_DEFAULT_VISIBILITY,
)

# Config setting to toggle local torch mode
# Use by running: bazel build ... --define TORCH_SOURCE=local
config_setting(
    name = "use_local_torch",
    define_values = {
        "TORCH_SOURCE": "local",
    },
)

TORCH_FROM_PYPROJECT = [req for req in WHEEL_REQUIRES if req.startswith("torch")]

# Define requirements list that conditionally includes torch
# If TORCH_SOURCE=local, we do not require any torch version, allowing
# the wheel to be installed alongside any local PyTorch version.
TORCH_REQ = select({
    ":use_local_torch": [],
    "//conditions:default": TORCH_FROM_PYPROJECT,
})

FILTERED_REQUIRES = [req for req in WHEEL_REQUIRES if not req.startswith("torch")]

pytype_strict_binary(
    name = "wheel_mapper_bin",
    srcs = ["wheel_mapper.py"],
    main = "wheel_mapper.py",
    visibility = ["//visibility:public"],
)

remap_pywrap_binaries(
    name = "remapped_pywrap_binaries",
    srcs = "//torch_tpu/common:pywrap_torch_tpu_binaries",
)

pytype_strict_library(
    name = "all_torch_tpu_files",
    srcs = [
        "//torch_tpu/_internal/compile:tpu_backend",
        "//torch_tpu/_internal/compiler_options",
        "//torch_tpu/_internal/device:_device_module",
        "//torch_tpu/_internal/device_utils:annotations",
        "//torch_tpu/_internal/distributed:gpu_env",
        "//torch_tpu/_internal/distributed/launchers:multihost_wrapper",
        "//torch_tpu/_internal/distributed/launchers:singlehost_wrapper",
        "//torch_tpu/_internal/dynamism",
        "//torch_tpu/_internal/execution_mode",
        "//torch_tpu/_internal/export",
        "//torch_tpu/_internal/pallas",
        "//torch_tpu/_internal/performance/micro:utils",
        "//torch_tpu/_internal/profiler",
        "//torch_tpu/_internal/shims/mlcompass:benchmark_data",
        "//torch_tpu/_internal/shims/mlcompass:export_lib_borg",
        "//torch_tpu/_internal/shims/pyglib/contrib/g3_multiprocessing",
        "//torch_tpu/_internal/shims/xprof:traceme",
        "//torch_tpu/_internal/shims/xprof:xprof_analysis_client",
        "//torch_tpu/_internal/shims/xprof:xprof_session",
        "//torch_tpu/_internal/stream:streams",
        "//torch_tpu/_internal/sync",
        "//torch_tpu/_internal/tracing",
        "//torch_tpu/_internal/utils",
        "//torch_tpu/_internal/utils:hardware",
        "//torch_tpu/_internal/utils:log_utils",
        "//torch_tpu/_internal/utils:tracer_utils",
        "//torch_tpu/api",
    ],
    visibility = ["//visibility:public"],
)

py_package(
    name = "torch_tpu_package_end",
    packages = ["torch_tpu"],
    visibility = ["//visibility:public"],
    deps = [
        ":all_torch_tpu_files",
    ],
)

py_wheel(
    name = "torch_tpu_wheel",
    abi = "cp312",
    author = "torch team",
    classifiers = [
        "Development Status :: 4 - Beta",
        "License :: OSI Approved :: Apache Software License",
        "Programming Language :: Python :: 3.12",
        "Topic :: Scientific/Engineering :: Artificial Intelligence",
    ],
    description_file = "//:README.md",
    distribution = "torch_tpu",
    entry_points = ENTRY_POINTS,
    homepage = "https://github.com/google-pytorch/torch_tpu",
    license = "Apache 2.0",
    platform = "manylinux_2_31_x86_64",
    # HERMETIC Python set to 3.12
    python_requires = ">=3.12",
    python_tag = "cp312",
    requires = FILTERED_REQUIRES + TORCH_REQ,
    strip_path_prefixes = ["ci/wheel/remapped_pywrap_binaries_pkg"],
    summary = "TPU/XLA support for PyTorch",
    tags = ["manual"],
    # base version set by pyproject.toml.
    version = WHEEL_VERSION,
    visibility = ["//visibility:public"],
    deps = [
        ":remapped_pywrap_binaries",
        ":torch_tpu_package_end",
    ],
)

_COMMON_ENV = {
    "WHEEL_PATH": "$(location :torch_tpu_wheel)",
    "PYPROJECT_PATH": "$(location //:pyproject.toml)",
}

py_test(
    name = "wheel_single_source_test",
    srcs = ["wheel_single_source_test.py"],
    data = [
        ":torch_tpu_wheel",
        "//:pyproject.toml",
    ],
    env = select({
        ":use_local_torch": _COMMON_ENV | {"LOCAL_TORCH": "1"},
        "//conditions:default": _COMMON_ENV,
    }),
    python_version = "PY3",
    deps = [
        "//shims/absl_py/testing:absltest",
    ],
)
