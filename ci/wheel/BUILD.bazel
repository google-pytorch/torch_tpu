load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("@torch_tpu_deps//:dependencies.bzl", "WHEEL_REQUIRES")
load("@torch_tpu_version//:version.bzl", "WHEEL_VERSION")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")
load("//bazel:pytorch_versions.bzl", "NIGHTLY_TORCH_VERSION", "WHEEL_TORCH_VERSIONS")
load("//bazel:supported_python_versions.bzl", "SUPPORTED_PYTHON_VERSIONS")
load("//build_files:build_defs.bzl", "torch_tpu_py_library", "torch_tpu_py_test")
load("//build_files:entry_points.bzl", "ENTRY_POINTS")
load("//ci/wheel:pywrap_mapper.bzl", "remap_pywrap_binaries")
load("//shims/build_files:torch_version.bzl", "version_suffix")
load("//shims/py_rules:pytype.bzl", "pytype_strict_binary")

package(
    default_visibility = PACKAGE_DEFAULT_VISIBILITY,
)

# Config setting to toggle local torch mode.
# Use by running: bazel build ... --config=local_torch
config_setting(
    name = "use_local_torch",
    flag_values = {
        "//shims/torch:local_torch": "True",
    },
)

TORCH_FROM_PYPROJECT = [req for req in WHEEL_REQUIRES if req.startswith("torch")]

[config_setting(
    name = "python_" + v.replace(".", "_"),
    define_values = {"PYTHON_VERSION": v},
) for v in SUPPORTED_PYTHON_VERSIONS if v != "3.12"]

# Define requirements list that conditionally includes torch
# In local torch mode we do not require any torch version, allowing
# the wheel to be installed alongside any local PyTorch version.
TORCH_REQ = select({
    ":use_local_torch": [],
    "//conditions:default": TORCH_FROM_PYPROJECT,
})

FILTERED_REQUIRES = [req for req in WHEEL_REQUIRES if not req.startswith("torch")]

pytype_strict_binary(
    name = "wheel_mapper_bin",
    srcs = ["wheel_mapper.py"],
    main = "wheel_mapper.py",
    visibility = ["//visibility:public"],
)

# The pip wheel is always the versioned, separated layout: one thin glue `.so`
# per supported PyTorch version, all sharing a single XLA/MLIR base library
# (libxla_base.so), with runtime dispatch (torch_tpu/_versioned_so_loader.py)
# selecting the glue for the installed torch. Each per-version pywrap_library
# lives in its own package, generated into @torch_tpu_glues from
# GLUE_TORCH_VERSIONS (see //bazel:glue_packages.bzl). The nightly glue rides
# along by default but is dropped under --config wheel_release, so artifacts
# published to an index carry only the release glues.
#
# Building this without --//:wheel_build=True fails at execution with an
# explanation and the correct invocation (see pywrap_mapper.bzl). The check
# lives in the action rather than in the rule implementation so that repo-wide
# tooling which configures every target -- bazel-diff's `generate-hashes
# --useCquery`, plain `bazel cquery //...` -- still analyzes cleanly.
remap_pywrap_binaries(
    name = "remapped_pywrap_binaries",
    srcs = [
        "@torch_tpu_glues//torch_tpu/csrc/common/glue_{}:binaries".format(version_suffix(v))
        for v in WHEEL_TORCH_VERSIONS
    ] + select({
        "//:nightly_glue_included": [
            "@torch_tpu_glues//torch_tpu/csrc/common/glue_{}:binaries".format(
                version_suffix(NIGHTLY_TORCH_VERSION),
            ),
        ],
        "//conditions:default": [],
    }),
)

torch_tpu_py_library(
    name = "all_torch_tpu_files",
    srcs = [
        # go/keep-sorted start
        "//src/torch_tpu",
        "//src/torch_tpu/_internal/benchmarks:benchmark_adapter",
        "//src/torch_tpu/_internal/benchmarks:export_adapter",
        "//src/torch_tpu/_internal/benchmarks:xprof_adapter",
        "//src/torch_tpu/_internal/compile/dynamic:view_decomposition",
        "//src/torch_tpu/_internal/compile/fx_passes:clone_mutated_returned_placeholders",
        "//src/torch_tpu/_internal/compile/fx_passes:propagate_symints",
        "//src/torch_tpu/_internal/compile/fx_passes:reorder_symints",
        "//src/torch_tpu/_internal/compile/fx_passes:sink_get_attr_constants",
        "//src/torch_tpu/_internal/compile:tpu_backend",
        "//src/torch_tpu/_internal/compiler_options",
        "//src/torch_tpu/_internal/device:_device_module",
        "//src/torch_tpu/_internal/device_utils:annotations",
        "//src/torch_tpu/_internal/distributed/launchers:multihost_wrapper",
        "//src/torch_tpu/_internal/distributed/launchers:singlehost_wrapper",
        "//src/torch_tpu/_internal/distributed:gpu_env",
        "//src/torch_tpu/_internal/distributed:handshake",
        "//src/torch_tpu/_internal/distributed:multiprocessing",
        "//src/torch_tpu/_internal/distributed:process_group_utils",
        "//src/torch_tpu/_internal/dynamism",
        "//src/torch_tpu/_internal/execution_mode",
        "//src/torch_tpu/_internal/export",
        "//src/torch_tpu/_internal/optim",
        "//src/torch_tpu/_internal/pallas",
        "//src/torch_tpu/_internal/performance/micro:utils",
        "//src/torch_tpu/_internal/profiler",
        "//src/torch_tpu/_internal/stream:streams",
        "//src/torch_tpu/_internal/sync",
        "//src/torch_tpu/_internal/tracing",
        "//src/torch_tpu/_internal/utils",
        "//src/torch_tpu/_internal/utils:hardware",
        "//src/torch_tpu/_internal/utils:log_utils",
        # TODO(wan): Remove test_utils from the wheel. Currently, some tests
        # fail without this in the wheel build.
        "//src/torch_tpu/_internal/utils:test_utils",
        "//src/torch_tpu/_internal/utils:tracer_utils",
        "//src/torch_tpu/ops",
        "//src/torch_tpu/ops:splash_attention",
        "//src/torch_tpu:_loader",
        # go/keep-sorted end
    ],
    allow_multiple_srcs = True,
    visibility = ["//visibility:public"],
)

py_package(
    name = "torch_tpu_package_end",
    packages = ["src/torch_tpu"],
    visibility = ["//visibility:public"],
    deps = [
        ":all_torch_tpu_files",
    ],
)

py_wheel(
    name = "torch_tpu_wheel",
    abi = select({
        ":python_3_11": "cp311",
        ":python_3_13": "cp313",
        ":python_3_14": "cp314",
        "//conditions:default": "cp312",
    }),
    author = "torch team",
    classifiers = [
        "Development Status :: 4 - Beta",
        "License :: OSI Approved :: Apache Software License",
        "Programming Language :: Python :: 3.12",
        "Topic :: Scientific/Engineering :: Artificial Intelligence",
    ],
    description_file = "//:README.md",
    distribution = "torch_tpu",
    entry_points = ENTRY_POINTS,
    homepage = "https://github.com/google-pytorch/torch_tpu",
    license = "Apache 2.0",
    platform = "manylinux_2_31_x86_64",
    python_requires = select({
        ":python_3_11": ">=3.11",
        ":python_3_13": ">=3.13",
        ":python_3_14": ">=3.14",
        "//conditions:default": ">=3.12",
    }),
    python_tag = select({
        ":python_3_11": "cp311",
        ":python_3_13": "cp313",
        ":python_3_14": "cp314",
        "//conditions:default": "cp312",
    }),
    requires = FILTERED_REQUIRES + TORCH_REQ,
    strip_path_prefixes = [
        "ci/wheel/remapped_pywrap_binaries_pkg",
        "src",
    ],
    summary = "TPU/XLA support for PyTorch",
    tags = ["manual"],
    # Publishing runs via twine outside Bazel. See ci/upload_wheel.sh.
    # Suppress the auto-generated `.publish` target, which rules_python
    # creates by default under bzlmod. It may lead to flaky PyPI fetches
    # of rules_python's internal twine deps.
    twine_binary = None,
    # base version set by pyproject.toml.
    version = WHEEL_VERSION,
    visibility = ["//visibility:public"],
    deps = [
        ":remapped_pywrap_binaries",
        ":torch_tpu_package_end",
    ],
)

_COMMON_ENV = {
    "WHEEL_PATH": "$(location :torch_tpu_wheel)",
    "PYPROJECT_PATH": "$(location //:pyproject.toml)",
}

torch_tpu_py_test(
    name = "wheel_single_source_test",
    srcs = ["wheel_single_source_test.py"],
    data = [
        "//:pyproject.toml",
    ],
    env = select({
        ":use_local_torch": _COMMON_ENV | {"LOCAL_TORCH": "1"},
        "//conditions:default": _COMMON_ENV,
    }),
    is_wheel_test = True,
    # Only meaningful against the wheel we actually ship, so it is skipped as
    # incompatible outside a wheel build rather than dragging the wheel (and
    # its build guard) into every job that happens to touch these files.
    target_compatible_with = select({
        "//:wheel_build_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//shims/absl_py/testing:absltest",
    ],
)

# Structural checks on the multi-ABI wheel: one shared libxla_base.so, a glue +
# torch common per built version, the shared base is XLA-only, and no libtorch
# is bundled. Needs nm/readelf/c++filt (binutils), which the image provides.
torch_tpu_py_test(
    name = "wheel_structure_test",
    srcs = ["wheel_structure_test.py"],
    env = {"WHEEL_PATH": "$(location :torch_tpu_wheel)"},
    is_wheel_test = True,
    nolocal = "Only run against explicit wheel targets",
    # `nolocal` keeps this out of wildcard expansion, but bazel-diff feeds
    # impacted targets as explicit labels, which ignores it. Same reasoning as
    # wheel_single_source_test above.
    target_compatible_with = select({
        "//:wheel_build_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//shims/absl_py/testing:absltest",
    ],
)

# Verifies the PyTorch/non-PyTorch split against the built wheel: imports
# torch_tpu (dlopening the extension glues) and asserts libxla_base.so defines
# no PyTorch symbols and the thin glues define no XLA symbols. It checks the
# artifact we actually ship, so run it with `--config wheel_test_cpu`, under
# which torch_tpu_py_test installs the wheel into a venv (via
# //:torch_tpu_py_import) and makes `import torch_tpu` resolve to it.
torch_tpu_py_test(
    name = "pywrap_split_test",
    srcs = ["pywrap_split_test.py"],
    is_wheel_test = True,
    # The versioned split (libxla_base.so + per-version glues) exists only in the
    # wheel, so this is meaningful only when --test_wheel is set (e.g.
    # --config wheel_test_cpu); it is skipped as incompatible otherwise.
    target_compatible_with = select({
        "//:wheel_test_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//shims/absl_py/testing:absltest",
        "//shims/torch:pytorch",
        "//src/torch_tpu",
        "//src/torch_tpu/_internal/compile",
        "//src/torch_tpu/_internal/sync",
    ],
)
