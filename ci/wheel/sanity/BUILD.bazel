load("@rules_python//python:py_test.bzl", "py_test")

package(
    default_visibility = ["//visibility:public"],
)

py_test(
    name = "package_sanity_check",
    testonly = True,
    srcs = ["package_sanity_check.py"],
    data = [
        ":actual_files.txt",
        ":registered_files.txt",
    ],
    main = "package_sanity_check.py",
)

genrule(
    name = "generate_actual_manifest",
    testonly = True,
    srcs = ["//:all_python_sources"],
    outs = ["actual_files.txt"],
    cmd = "python3 $(location :generate_manifest.py) $(SRCS) > $@",
    tools = [":generate_manifest.py"],
)

genrule(
    name = "generate_registration_manifest",
    testonly = True,
    srcs = [
        "//ci/wheel:all_torch_tpu_files_srcs",
        "//:wheel_extra_test_deps_srcs",
    ],
    outs = ["registered_files.txt"],
    cmd = "python3 $(location :generate_manifest.py) $(SRCS) > $@",
    tools = [":generate_manifest.py"],
)
