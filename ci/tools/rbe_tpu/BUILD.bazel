load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
    name = "rbe_tpu",
    srcs = [
        "__init__.py",
        "agent.py",
        "binding.py",
        "config.py",
        "fake_gcs.py",
        "gcs.py",
        "health.py",
        "protocol.py",
        "runner.py",
        "worker.py",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "agent_main",
    srcs = ["agent_main.py"],
    deps = [":rbe_tpu"],
)

py_binary(
    name = "worker_main",
    srcs = ["worker_main.py"],
    deps = [":rbe_tpu"],
)

py_test(
    name = "gcs_test",
    srcs = ["gcs_test.py"],
    deps = [":rbe_tpu"],
)

py_test(
    name = "binding_test",
    srcs = ["binding_test.py"],
    deps = [":rbe_tpu"],
)

py_test(
    name = "health_test",
    srcs = ["health_test.py"],
    deps = [":rbe_tpu"],
)

py_test(
    name = "agent_test",
    srcs = ["agent_test.py"],
    deps = [":rbe_tpu"],
)

py_test(
    name = "worker_test",
    srcs = ["worker_test.py"],
    deps = [":rbe_tpu"],
)

py_test(
    name = "runner_test",
    srcs = ["runner_test.py"],
    deps = [":rbe_tpu"],
)

py_test(
    name = "integration_test",
    srcs = ["integration_test.py"],
    deps = [":rbe_tpu"],
)

py_test(
    name = "main_test",
    srcs = ["main_test.py"],
    deps = [
        ":agent_main",
        ":rbe_tpu",
        ":worker_main",
    ],
)
