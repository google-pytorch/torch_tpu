[Unit]
Description=Torch TPU Relay Mailbox Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/default/torch-tpu-rbe-agent
ExecStart=/usr/bin/python3 -m ci.tools.rbe_tpu.agent_main
WorkingDirectory=/opt/torch_tpu
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
