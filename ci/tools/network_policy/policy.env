# The CI network retry/timeout policy: the single source of truth for every
# retry count, delay, and timeout the OSS CI applies to network traffic.
#
# Data only: `KEY=VALUE` lines, `#` comments, no quoting and no shell
# expansion, so that activate.sh can source it and export it via GITHUB_ENV.
# In CI, activate.sh exports these values as they are. Outside CI, noxfile.py
# runs activate.sh and fills in only the keys the environment does not already
# set.
#
# Every key is exported into the job by activate.sh. See ci/README.md for how
# the policy reaches each tool.

# uv -- read natively by uv, uvx, nox-managed virtual environments,
# `uv run --with ...` and `uv pip compile` (uv >= 0.7.21 for the retries).
# Retries per HTTP request (uv's own default is 3).
UV_HTTP_RETRIES=8
# Timeout per HTTP request, in seconds (uv's own default is 30).
UV_HTTP_TIMEOUT=120

# pip -- pip reads PIP_<OPTION> for any command-line option, so these cover
# every pip invocation that does not pass the option itself (the pip that
# Bazel's rules_python drives gets explicit flags from MODULE.bazel).
# Retries per download (`--retries`).
PIP_RETRIES=5
# Socket timeout, in seconds (`--timeout`).
PIP_TIMEOUT=120

# curl, via the .curlrc that activate.sh renders and points CURL_HOME at.
# `retry-delay` is intentionally omitted so curl uses its built-in exponential
# backoff instead of a fixed interval.
# Retries per transfer.
DOWNLOAD_RETRIES=5
# Upper bound on the time spent retrying one transfer, in seconds.
DOWNLOAD_RETRY_MAX_TIME=120
# Connection timeout, in seconds.
DOWNLOAD_CONNECT_TIMEOUT=30
