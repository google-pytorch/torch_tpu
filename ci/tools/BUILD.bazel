load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")

exports_files(
    ["run_cc_tpu_test.sh"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "list_ci_tests",
    srcs = ["list_ci_tests.py"],
    data = [
        "//:.bazelrc",
        "//:github_workflows",
    ],
    deps = [
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "list_ci_tests_test",
    srcs = ["list_ci_tests_test.py"],
    data = [
        "//:.bazelrc",
        "//:github_workflows",
    ],
    deps = [
        ":list_ci_tests",
    ],
)

py_binary(
    name = "python_versions",
    srcs = ["python_versions.py"],
    data = [
        "//bazel:supported_python_versions.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

py_test(
    name = "python_versions_test",
    srcs = ["python_versions_test.py"],
    data = [
        "//bazel:supported_python_versions.bzl",
        "//requirements:all_requirements_files",
    ],
    deps = [
        ":python_versions",
    ],
)

# Note: the copy.bara.sky assertion is skipped when that file is absent,
# which is the case in the GitHub export and under the Bazel sandbox. It
# runs for real via the nox session in a full checkout.
py_binary(
    name = "check_python_version_sync",
    srcs = ["check_python_version_sync.py"],
    data = [
        "//:.bazelrc",
        "//:MODULE.bazel",
        "//:WORKSPACE",
        "//:github_workflows",
        "//bazel:supported_python_versions.bzl",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":python_versions",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "check_python_version_sync_test",
    srcs = ["check_python_version_sync_test.py"],
    data = [
        "//:.bazelrc",
        "//:MODULE.bazel",
        "//:WORKSPACE",
        "//:github_workflows",
        "//bazel:supported_python_versions.bzl",
    ],
    deps = [
        ":check_python_version_sync",
    ],
)
