load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

exports_files(
    [
        "custom_lint.py",
        "custom_lint_rules.py",
        "custom_lint.sh",
        "custom_lint_test.py",
        "run_cc_tpu_test.sh",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "torch_test_module_utils",
    testonly = True,
    srcs = ["torch_test_module_utils.py"],
)

py_binary(
    name = "gen_torch_tests",
    testonly = True,
    srcs = ["gen_torch_tests.py"],
    deps = [
        ":torch_test_module_utils",
    ],
)

py_test(
    name = "gen_torch_tests_test",
    srcs = ["gen_torch_tests_test.py"],
    deps = [
        ":gen_torch_tests",
    ],
)

py_binary(
    name = "delete_cancelled_pr_runs",
    srcs = ["delete_cancelled_pr_runs.py"],
)

py_test(
    name = "delete_cancelled_pr_runs_test",
    size = "small",
    srcs = ["delete_cancelled_pr_runs_test.py"],
    deps = [
        ":delete_cancelled_pr_runs",
    ],
)

py_binary(
    name = "list_ci_tests",
    srcs = ["list_ci_tests.py"],
    data = [
        "//:.bazelrc",
        "//:github_workflows",
    ],
    deps = [
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "list_ci_tests_test",
    srcs = ["list_ci_tests_test.py"],
    data = [
        "//:.bazelrc",
        "//:github_workflows",
    ],
    deps = [
        ":list_ci_tests",
    ],
)

py_binary(
    name = "run_bazel_diff",
    srcs = ["run_bazel_diff.py"],
)

py_test(
    name = "run_bazel_diff_test",
    srcs = ["run_bazel_diff_test.py"],
    deps = [
        ":run_bazel_diff",
    ],
)
