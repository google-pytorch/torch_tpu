# Sample rules for custom_linter's CLI tests.
# proto-file: devtools/metadata/metadata.proto
# proto-message: MetaData

presubmit {
  path_regexp: ".*\\.py"
  path_expression_exclusion: "tests/..."

  check_contents {
    base {
      id: "CheckNoPrint"
      disable_tags: "ROLLBACK_OF"
    }
    failure_status: WARNING
    failure_message: "Use logging instead of print()."
    prohibited_regexp: "\\bprint\\("
    suppression_regexp: "\\bPRINT_OK=.+"
    check_delta_only: true
  }
}

presubmit {
  path_regexp: ".*\\.(cc|h)"

  check_contents {
    base {
      id: "CheckLicense"
    }
    failure_message: "Missing license header."
    required_regexp: "Copyright \\d{4}"
    match_entire_file: true
  }

  check_contents {
    base {
      id: "CheckYear"
    }
    # Only for existing files: new files may carry any year.
    operation: EDIT
    check_delta_only: true
    failure_message: "Do not update the copyright year."
    prohibited_regexp: "Copyright \\d{4}"
  }

  check_description {
    base {
      id: "CheckDescription"
    }
    required_regexp: "BUG="
  }
}
