ARG BASEIMAGE=python:3.12-slim-bookworm

# =====================================================================
# Stage 0: Base Image (torchtpu-base)
# =====================================================================
FROM $BASEIMAGE AS base

# Install runtime system dependencies
RUN apt-get update && apt-get install -y libgoogle-perftools-dev && \
    rm -rf /var/lib/apt/lists/*


# Ensure python3 is available in /usr/bin for Bazel shims and local scripts.
RUN ln -sf $(which python) /usr/bin/python3

RUN pip install uv

WORKDIR /workspace

# Copy pyproject.toml to install dependencies
COPY pyproject.toml .



# Install all dependencies from pyproject.toml (including optional ones for dev/test)
# We let uv read pyproject.toml to use the explicit pytorch-cpu index only for torch/torchvision!
RUN uv pip compile pyproject.toml --all-extras --python-version 3.12 --python-platform x86_64-manylinux_2_31 --resolution lowest-direct --generate-hashes --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match -o requirements.txt && \
    uv pip install --system -r requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match
# Enable tcmalloc by default for all derived images
ENV LD_PRELOAD="/usr/lib/x86_64-linux-gnu/libtcmalloc.so.4"

# =====================================================================
# Stage 1: Builder Image (torchtpu-builder)
# =====================================================================
FROM base AS builder

# Install build-time system dependencies
RUN apt-get update && apt-get install -y curl gnupg git && \
    rm -rf /var/lib/apt/lists/*

# Install bazelisk for bazel management
RUN curl -L https://github.com/bazelbuild/bazelisk/releases/download/v1.19.0/bazelisk-linux-amd64 -o /usr/local/bin/bazel && \
    chmod +x /usr/local/bin/bazel

# Set working directory
WORKDIR /workspace

# Copy the local repository source from the build context
COPY . /workspace/torch_tpu_src



# Build the wheel using bazel.
# Preserving cache mounts and flags from Dockerfile.from_src
RUN --mount=type=cache,id=torch-tpu-bazelisk,target=/root/.cache/bazelisk \
    --mount=type=cache,id=torch-tpu-bazel-repo,target=/root/.cache/bazel,sharing=locked \
    --mount=type=cache,target=/root/.cache/uv \
    cd /workspace/torch_tpu_src && \
    rm -rf bazel-* && \
    bazel build -c opt \
    --config=wheel_common \
    --repository_cache=/root/.cache/bazel/repository_cache \
    --disk_cache=/root/.cache/bazel/disk_cache \
    //ci/wheel:torch_tpu_wheel --config=no_rbe && \
    mkdir -p dist && mv bazel-bin/ci/wheel/* dist/



# =====================================================================
# Stage 2: Final Image (torchtpu)
# =====================================================================
FROM base AS final

WORKDIR /opt/wheels

# Pull the fresh wheel from the builder stage
COPY --from=builder /workspace/torch_tpu_src/dist/*.whl .

# Install the wheel forcing reinstall to overwrite metadata-only install from base stage
RUN pip install --force-reinstall --no-deps *.whl

# Maintain hierarchy: Copy examples to /workspace/examples
COPY --from=builder /workspace/torch_tpu_src/examples /workspace/examples

# Ensure /workspace is in the Python path and output is unbuffered
ENV PYTHONPATH="/workspace"
ENV PYTHONUNBUFFERED=1

# Default command
CMD ["/bin/bash"]
