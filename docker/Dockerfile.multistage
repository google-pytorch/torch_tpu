ARG BASEIMAGE=python:3.14-slim-bookworm

# =====================================================================
# Stage 0: Base Image (torchtpu-base)
# =====================================================================
FROM $BASEIMAGE AS base

# Install runtime system dependencies
RUN apt-get update && apt-get install -y libgoogle-perftools-dev && \
    rm -rf /var/lib/apt/lists/*


# Ensure python3 is available in /usr/bin for Bazel shims and local scripts.
RUN ln -sf $(which python) /usr/bin/python3

RUN pip install uv

WORKDIR /workspace

# Copy pyproject.toml to install dependencies
COPY pyproject.toml .



# Install all dependencies from pyproject.toml (including optional ones for dev/test)
# We let uv read pyproject.toml to use the explicit pytorch-cpu index only for torch/torchvision!
RUN uv pip compile pyproject.toml --all-extras --python-version 3.14 --python-platform x86_64-manylinux_2_31 --resolution lowest-direct --generate-hashes --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match -o requirements.txt && \
    uv pip install --system -r requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match
# Enable tcmalloc by default for all derived images
ENV LD_PRELOAD="/usr/lib/x86_64-linux-gnu/libtcmalloc.so.4"

# =====================================================================
# Stage 1: Final Image (torchtpu)
# =====================================================================
FROM base AS final

ARG GCLOUD_TOKEN=""

WORKDIR /opt/wheels

# Copy prebuilt wheel(s) from dist/ if present in the build context.
# pyproject.toml ensures COPY succeeds even when dist is empty or omitted.
COPY pyproject.toml dist* /opt/wheels/

# If a prebuilt wheel was provided, install it.
# Otherwise, download the latest nightly torch_tpu wheel authenticated from Google Cloud Artifact Registry.
# Supports BuildKit secret (--mount=type=secret,id=gcloud_token) or build argument (--build-arg GCLOUD_TOKEN=...).
RUN --mount=type=secret,id=gcloud_token \
    set -eu; \
    if ls /opt/wheels/*.whl 1>/dev/null 2>&1; then \
      echo "===> Installing provided prebuilt wheel(s)..."; \
    else \
      echo "===> No prebuilt wheel provided; fetching latest nightly from Artifact Registry..."; \
      TOKEN="${GCLOUD_TOKEN}"; \
      if [ -f /run/secrets/gcloud_token ]; then TOKEN="$(cat /run/secrets/gcloud_token)"; fi; \
      if [ -z "${TOKEN}" ]; then \
        echo "Error: Missing prebuilt wheel in dist/ and missing BuildKit secret (id=gcloud_token) or build arg (GCLOUD_TOKEN) for Artifact Registry authentication." >&2; \
        exit 1; \
      fi; \
      pip download --no-deps --pre torch_tpu \
          --index-url "https://oauth2accesstoken:${TOKEN}@us-python.pkg.dev/ml-oss-artifacts-transient/torch-tpu-virtual-registry/simple/" \
          --only-binary=:all: \
          -d /opt/wheels; \
    fi; \
    pip install --force-reinstall --no-deps /opt/wheels/*.whl

# Maintain hierarchy: Copy examples to /workspace/examples
COPY examples /workspace/examples

WORKDIR /workspace

# Ensure /workspace is in the Python path and output is unbuffered
ENV PYTHONPATH="/workspace"
ENV PYTHONUNBUFFERED=1

# Default command
CMD ["/bin/bash"]


