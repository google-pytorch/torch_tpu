load("@rules_python//python:py_library.bzl", "py_library")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")

package(default_visibility = PACKAGE_DEFAULT_VISIBILITY)

# ortools does not yet publish Python 3.15 wheels on PyPI, so it is excluded via
# requirements/overrides_3_15.txt.
#
# `:optional` omits `@pypi//ortools` on Python 3.15 without marking downstream
# targets incompatible, so `torch_tpu` (which imports `ortools` optionally at
# runtime in `smt_checker.py`) stays buildable on Python 3.15.
#
# `:ortools` additionally sets `target_compatible_with` to skip tests that
# require CP-SAT (`cp_model`) at runtime on Python 3.15.
py_library(
    # PY_LIBRARY_OK=OSS optional dependency shim over Python version
    name = "optional",
    deps = select({
        "@rules_python//python/config_settings:is_python_3.15": [],
        "//conditions:default": ["@pypi//ortools"],
    }),
)

py_library(
    # PY_LIBRARY_OK=OSS dependency shim with target_compatible_with over Python version
    name = "ortools",
    target_compatible_with = select({
        "@rules_python//python/config_settings:is_python_3.15": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":optional"],
)
