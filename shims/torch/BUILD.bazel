load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:py_library.bzl", "py_library")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")
load("//shims/torch:torch_wheel_select.bzl", "torch_headers_select", "torch_lib_select", "torch_py_select")

package(default_visibility = PACKAGE_DEFAULT_VISIBILITY)

# The torch shared libraries, selected by the //:_torch_version build flag (set
# per-glue by the pybind transition) and, for the default version, the Python
# version. The extra-version rows are generated by torch_lib_select from the
# single source of truth in //bazel:pytorch_versions.bzl.
alias(
    name = "libc10",
    actual = select(torch_lib_select(
        "libc10",
        {
            "//:wheel_test_3_11": "@pypi_torch_311//:libc10",
            "//:wheel_test_3_12": "@pypi_torch_312//:libc10",
            "//:wheel_test_3_13": "@pypi_torch_313//:libc10",
            "//:wheel_test_3_14": "@pypi_torch_314//:libc10",
            "//conditions:default": "@pypi_torch_312//:libc10",
        },
    )),
)

alias(
    name = "libtorch_cpu",
    actual = select(torch_lib_select(
        "libtorch_cpu",
        {
            "//:wheel_test_3_11": "@pypi_torch_311//:libtorch_cpu",
            "//:wheel_test_3_12": "@pypi_torch_312//:libtorch_cpu",
            "//:wheel_test_3_13": "@pypi_torch_313//:libtorch_cpu",
            "//:wheel_test_3_14": "@pypi_torch_314//:libtorch_cpu",
            "//conditions:default": "@pypi_torch_312//:libtorch_cpu",
        },
    )),
)

alias(
    name = "libtorch_python",
    actual = select(torch_lib_select(
        "libtorch_python",
        {
            "//:wheel_test_3_11": "@pypi_torch_311//:libtorch_python",
            "//:wheel_test_3_12": "@pypi_torch_312//:libtorch_python",
            "//:wheel_test_3_13": "@pypi_torch_313//:libtorch_python",
            "//:wheel_test_3_14": "@pypi_torch_314//:libtorch_python",
            "//conditions:default": "@pypi_torch_312//:libtorch_python",
        },
    )),
)

# Local torch mode: build against a locally provided PyTorch wheel instead of
# the pip hubs. Use by running: bazel build ... --config=local_torch (with the
# TORCH_SOURCE env var pointing at the wheel; see .bazelrc). This flag is the
# single switch for the mode: the config sets it, every local-torch
# config_setting keys on it, and the glue version transition reads it to keep
# local builds in a single torch configuration.
bool_flag(
    name = "local_torch",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Config setting to toggle local torch mode.
# Other packages refer to this as "//shims/torch:use_local_torch".
config_setting(
    name = "use_local_torch",
    flag_values = {
        ":local_torch": "True",
    },
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "cuda_torch",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "use_cuda_torch",
    flag_values = {
        ":cuda_torch": "True",
    },
    visibility = ["//visibility:public"],
)

_CUDA_PYPI_DEPS = [
    "@pypi_cuda//torch",
    "@pypi_cuda//cuda_bindings",
    "@pypi_cuda//cuda_toolkit",
    "@pypi_cuda//nvidia_cublas",
    "@pypi_cuda//nvidia_cuda_cupti",
    "@pypi_cuda//nvidia_cuda_nvrtc",
    "@pypi_cuda//nvidia_cuda_runtime",
    "@pypi_cuda//nvidia_cudnn_cu13",
    "@pypi_cuda//nvidia_cufile",
    "@pypi_cuda//nvidia_cufft",
    "@pypi_cuda//nvidia_curand",
    "@pypi_cuda//nvidia_cusolver",
    "@pypi_cuda//nvidia_cusparse",
    "@pypi_cuda//nvidia_cusparselt_cu13",
    "@pypi_cuda//nvidia_nccl_cu13",
    "@pypi_cuda//nvidia_nvjitlink",
    "@pypi_cuda//nvidia_nvshmem_cu13",
    "@pypi_cuda//nvidia_nvtx",
    "@pypi_cuda//triton",
]

# TODO: b/457858115 - Bazel likely enforces strict dependencies and requires optional dependencies
# to be explicitly listed in deps if they are used.
# Python Rules: Depend on PyPI torch by default, but skip it for local builds
# (because local builds assume torch is already in the environment)
py_library(
    # PY_LIBRARY_OK=OSS torch shim target
    name = "pytorch",
    deps = select(torch_py_select(
        {
            ":use_local_torch": [
                "@local_torch//:torch",
                "@pypi//numpy",
            ],
            ":use_cuda_torch": _CUDA_PYPI_DEPS + [
                "@pypi_cuda//numpy",
            ],
            "//conditions:default": [
                "@pypi//numpy",
                "@pypi//torch",
            ],
        },
        extra = ["@pypi//numpy"],
    )),
)

py_library(
    # PY_LIBRARY_OK=OSS torch shim target
    name = "testing_internal",
    deps = select(torch_py_select(
        {
            ":use_local_torch": [
                "@local_torch//:torch",
                "@pypi//expecttest",
                "@pypi//numpy",
            ],
            ":use_cuda_torch": _CUDA_PYPI_DEPS + [
                "@pypi_cuda//expecttest",
                "@pypi_cuda//numpy",
            ],
            "//conditions:default": [
                "@pypi//expecttest",
                "@pypi//numpy",
                "@pypi//torch",
            ],
        },
        extra = [
            "@pypi//expecttest",
            "@pypi//numpy",
        ],
    )),
)

# Alias test_libs to :pytorch so it inherits the conditional logic
alias(
    name = "test_libs",
    actual = ":pytorch",
)

# C++ Rules: Switch between pip headers and local headers.
#
# The C++ shims select along two independent dimensions -- "headers-only?"
# (//:_torch_headers_only, set by the wheel transitions for the shared,
# torch-free XLA base) and "which torch source?" (:local_torch) -- as a chain
# of single-dimension selects: the shim itself branches only on headers-only
# and falls through to a *_runtime_libs library that branches only on the
# torch source. Each select can match at most one non-default row, so
# headers-only wins over everything by construction, without relying on
# config_setting specialization. Keep it that way: never mix rows from both
# dimensions in one select table.

# The real torch libraries a full-link build links against, by torch source.
# Reached only through the //conditions:default rows of the shims below, i.e.
# never in a headers-only configuration.
cc_library(
    # ALLOW_CC_TARGETS=External PyTorch dependency
    name = "torch_runtime_libs",
    deps = select({
        ":use_local_torch": [
            "@local_torch//:libc10",
            "@local_torch//:libtorch_cpu",
        ],
        ":use_cuda_torch": [
            "@pypi_cuda//torch:libc10",
            "@pypi_cuda//torch:libtorch_cpu",
        ],
        # NOTE: All dependencies below will be added to the torch_tpu wheel.
        # If you are adding a new dependency that is not for the wheel, please make a new shim.
        "//conditions:default": [
            ":libc10",
            ":libtorch_cpu",
        ],
    }),
)

cc_library(
    # ALLOW_CC_TARGETS=External PyTorch dependency
    name = "torch",
    deps = [
        ":aten",
        ":torch_headers",
    ] + select({
        # Per-version wheel glues: headers only, torch symbols resolved at runtime.
        "//:torch_headers_only_enabled": [],
        "//conditions:default": [":torch_runtime_libs"],
    }),
)

cc_library(
    # ALLOW_CC_TARGETS=External PyTorch dependency
    name = "aten",
    deps = select({
        # Per-version wheel glues: headers only, torch symbols resolved at runtime.
        "//:torch_headers_only_enabled": [":aten_headers"],
        "//conditions:default": [":torch_runtime_libs"],
    }),
)

cc_library(
    # ALLOW_CC_TARGETS=External PyTorch dependency
    name = "aten_headers",
    deps = select(torch_headers_select({
        ":use_local_torch": ["@local_torch//:torch_headers"],
        ":use_cuda_torch": ["@pypi_cuda//torch:torch_headers"],
        "//conditions:default": ["@pypi//torch:torch_headers"],
    })),
)

cc_library(
    # ALLOW_CC_TARGETS=External PyTorch dependency
    name = "torch_headers",
    deps = select(torch_headers_select(
        {
            ":use_local_torch": [
                "@local_torch//:torch_headers",
                "@rules_python//python/cc:current_py_cc_headers",
            ],
            ":use_cuda_torch": [
                "@pypi_cuda//torch:torch_headers",
                "@rules_python//python/cc:current_py_cc_headers",
            ],
            "//conditions:default": [
                "@pypi//torch:torch_headers",
                "@rules_python//python/cc:current_py_cc_headers",
            ],
        },
        extra = ["@rules_python//python/cc:current_py_cc_headers"],
    )),
)

# Note: @local_torch//:libtorch_python is added for local builds to fix ABI linking
cc_library(
    # ALLOW_CC_TARGETS=External PyTorch dependency
    name = "torch_python_runtime_libs",
    deps = select({
        ":use_local_torch": [
            "@local_torch//:libtorch_python",
            "@local_torch//:torch_headers",
        ],
        ":use_cuda_torch": [
            "@pypi_cuda//torch:libtorch_python",
            "@pypi_cuda//torch:torch_headers",
        ],
        "//conditions:default": [
            ":libtorch_python",
            "@pypi//torch:torch_headers",
        ],
    }),
)

cc_library(
    # ALLOW_CC_TARGETS=External PyTorch dependency
    name = "torch_python",
    deps = select({
        # Per-version wheel glues: headers only, torch symbols resolved at runtime.
        "//:torch_headers_only_enabled": [":torch_headers"],
        "//conditions:default": [":torch_python_runtime_libs"],
    }),
)

cc_library(
    # ALLOW_CC_TARGETS=External PyTorch dependency
    name = "kineto",
    visibility = ["//visibility:public"],
    deps = [":torch"],
)

py_library(
    # PY_LIBRARY_OK=OSS torch shim target
    name = "tensorboard_support",
    deps = [
        "@pypi//tensorboard",
    ],
)
