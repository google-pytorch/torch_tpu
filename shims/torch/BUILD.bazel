load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:py_library.bzl", "py_library")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")
load("//shims/torch:torch_wheel_select.bzl", "torch_headers_select", "torch_lib_select")

package(default_visibility = PACKAGE_DEFAULT_VISIBILITY)

# The torch shared libraries, selected by the //:_torch_version build flag (set
# per-glue by the pybind transition) and, for the default version, the Python
# version. The extra-version rows are generated by torch_lib_select from the
# single source of truth in //bazel:pytorch_versions.bzl.
alias(
    name = "libc10",
    actual = select(torch_lib_select("libc10", {
        "//:wheel_test_3_11": "@pypi_torch_311//:libc10",
        "//:wheel_test_3_12": "@pypi_torch_312//:libc10",
        "//:wheel_test_3_13": "@pypi_torch_313//:libc10",
        "//:wheel_test_3_14": "@pypi_torch_314//:libc10",
        "//conditions:default": "@pypi_torch_312//:libc10",
    })),
)

alias(
    name = "libtorch_cpu",
    actual = select(torch_lib_select("libtorch_cpu", {
        "//:wheel_test_3_11": "@pypi_torch_311//:libtorch_cpu",
        "//:wheel_test_3_12": "@pypi_torch_312//:libtorch_cpu",
        "//:wheel_test_3_13": "@pypi_torch_313//:libtorch_cpu",
        "//:wheel_test_3_14": "@pypi_torch_314//:libtorch_cpu",
        "//conditions:default": "@pypi_torch_312//:libtorch_cpu",
    })),
)

alias(
    name = "libtorch_python",
    actual = select(torch_lib_select("libtorch_python", {
        "//:wheel_test_3_11": "@pypi_torch_311//:libtorch_python",
        "//:wheel_test_3_12": "@pypi_torch_312//:libtorch_python",
        "//:wheel_test_3_13": "@pypi_torch_313//:libtorch_python",
        "//:wheel_test_3_14": "@pypi_torch_314//:libtorch_python",
        "//conditions:default": "@pypi_torch_312//:libtorch_python",
    })),
)

# Config setting to toggle local torch mode.
# Use by running: bazel build ... --define TORCH_SOURCE=local
# Other packages refer to this as "//shims/torch:use_local_torch"
config_setting(
    name = "use_local_torch",
    define_values = {
        "TORCH_SOURCE": "local",
    },
    visibility = ["//visibility:public"],
)

# TODO: b/457858115 - Bazel likely enforces strict dependencies and requires optional dependencies
# to be explicitly listed in deps if they are used.
# Python Rules: Depend on PyPI torch by default, but skip it for local builds
# (because local builds assume torch is already in the environment)
py_library(
    name = "pytorch",
    deps = [
        "@pypi//numpy",
    ] + select({
        ":use_local_torch": ["@local_torch//:torch"],
        "//conditions:default": ["@pypi//torch"],
    }),
)

py_library(
    name = "testing_internal",
    deps = [
        "@pypi//expecttest",
        "@pypi//numpy",
    ] + select({
        ":use_local_torch": ["@local_torch//:torch"],
        "//conditions:default": ["@pypi//torch"],
    }),
)

# Alias test_libs to :pytorch so it inherits the conditional logic
alias(
    name = "test_libs",
    actual = ":pytorch",
)

# C++ Rules: Switch between pip headers and local headers
# Note: @local_torch//:libtorch_python is added for local builds to fix ABI linking
cc_library(
    name = "torch",
    deps = [
        ":aten",
        ":torch_headers",
    ] + select({
        # Per-version wheel glues: headers only, torch symbols resolved at runtime.
        "//:torch_headers_only_enabled": [],
        # NOTE: Keep this list in sync with the default case one for local_torch and pypi_torch.
        # Any target-specific dependencies should be declared with the specific target/binary
        ":use_local_torch": [
            "@local_torch//:libc10",
            "@local_torch//:libtorch_cpu",
        ],
        # NOTE: All dependencies below will be added to the torch_tpu wheel.
        # If you are adding a new dependency that is not for the wheel, please make a new shim.
        "//conditions:default": [
            ":libc10",
            ":libtorch_cpu",
        ],
    }),
)

cc_library(
    name = "aten",
    deps = select({
        # Per-version wheel glues: headers only, torch symbols resolved at runtime.
        "//:torch_headers_only_enabled": [":aten_headers"],
        # NOTE: Keep this list in sync with the default case one for local_torch and pypi_torch.
        # Any target-specific dependencies should be declared with the specific target/binary
        ":use_local_torch": [
            "@local_torch//:libc10",
            "@local_torch//:libtorch_cpu",
        ],
        "//conditions:default": [
            ":libc10",
            ":libtorch_cpu",
        ],
    }),
)

cc_library(
    name = "aten_headers",
    deps = select(torch_headers_select({
        ":use_local_torch": ["@local_torch//:torch_headers"],
        "//conditions:default": ["@pypi//torch:torch_headers"],
    })),
)

cc_library(
    name = "torch_headers",
    deps = select(torch_headers_select(
        {
            ":use_local_torch": [
                "@local_torch//:torch_headers",
                "@rules_python//python/cc:current_py_cc_headers",
            ],
            "//conditions:default": [
                "@pypi//torch:torch_headers",
                "@rules_python//python/cc:current_py_cc_headers",
            ],
        },
        extra = ["@rules_python//python/cc:current_py_cc_headers"],
    )),
)

cc_library(
    name = "torch_python",
    deps = select({
        # Per-version wheel glues: headers only, torch symbols resolved at runtime.
        "//:torch_headers_only_enabled": [":torch_headers"],
        # NOTE: Keep this list in sync with the default case one for local_torch and pypi_torch.
        # Any target-specific dependencies should be declared with the specific target/binary
        ":use_local_torch": [
            "@local_torch//:libtorch_python",
            "@local_torch//:torch_headers",
        ],
        "//conditions:default": [
            ":libtorch_python",
            "@pypi//torch:torch_headers",
        ],
    }),
)

cc_library(
    name = "kineto",
    visibility = ["//visibility:public"],
    deps = [":torch"],
)

py_library(
    name = "tensorboard_support",
    deps = [
        "@pypi//tensorboard",
    ],
)
