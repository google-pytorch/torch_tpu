module(
    name = "torch_tpu",
    version = "0.2.1",
)

SUPPORTED_PYTHON_VERSIONS = [
    "3.11",
    "3.12",
    "3.13",
    "3.14",
    "3.14t",
]

# rules_python's python.toolchain and pip.parse key off the major.minor CPython
# version; free-threaded variants (e.g. "3.14t") share the same minor-version
# toolchain registration and select the free-threaded build via
# --@rules_python//python/config_settings:py_freethreaded=yes.
_CPYTHON_MINOR_VERSIONS = [
    v
    for v in SUPPORTED_PYTHON_VERSIONS
    if not v.endswith("t")
]

# When simpleapi_download is enabled, rules_python resolves platform wheels
# against target_platforms (expanding "{os}" and "{arch}"). Free-threaded
# wheels (cp314t) carry the cp314t ABI tag and are only selected when
# "{os}_{arch}_freethreaded" is listed.
_TARGET_PLATFORMS_BY_PYTHON = {
    v: (
        ["{os}_{arch}", "{os}_{arch}_freethreaded"]
        if v + "t" in SUPPORTED_PYTHON_VERSIONS
        else ["{os}_{arch}"]
    )
    for v in _CPYTHON_MINOR_VERSIONS
}

# The Python version the standard build defaults to. Like the list above, the
# single source of truth is //bazel:supported_python_versions.bzl -- this copy
# exists because MODULE.bazel cannot load() Starlark, and is kept in sync by
# hand.
DEFAULT_PYTHON_VERSION = "3.14"

# BCR dependencies
bazel_dep(name = "abseil-cpp", version = "20260526.0", repo_name = "com_google_absl")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "curl", version = "8.11.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_testing", version = "0.7.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "33.6", repo_name = "com_google_protobuf")
bazel_dep(name = "googletest", version = "1.15.2", repo_name = "com_google_googletest")
bazel_dep(name = "grpc", version = "1.78.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "googleapis", version = "0.0.0-20240819-fe8ba054a")
bazel_dep(name = "highway", version = "1.4.0")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1", repo_name = "com_googlesource_code_re2")
bazel_dep(name = "tcmalloc", version = "0.0.0-20250927-12f2552", repo_name = "com_google_tcmalloc")

# 1.34.6.bcr.1 was yanked (CVE-2025-62408) in
# https://github.com/bazelbuild/bazel-central-registry/commit/7ad3b207da8ead122a676e1597e1fc85a6fbee79
# TODO: Remove once the pinned XLA depends on c-ares >= 1.34.6.bcr.3.
bazel_dep(name = "c-ares", version = "1.34.6.bcr.3", repo_name = None)

# BCR overrides

single_version_override(
    module_name = "curl",
    patches = ["//bazel/patches/curl:remove_linker_script.patch"],
    version = "8.11.0",
)

single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = ["//bazel/patches/grpc:grpc.patch"],
    version = "1.78.0",
)

# TODO(ecalubaquib): Remove once googleapis is updated to a version compatible with current
# rules_python. This will allow us to run bazel mod graph
single_version_override(
    module_name = "googleapis",
    version = "0.0.0-20240819-fe8ba054a",
)

# Non-BCR or specific commit modules
bazel_dep(name = "xla")
bazel_dep(name = "rules_ml_toolchain")

archive_override(
    module_name = "xla",
    integrity = "sha256-NZl1I+II0JDnJOXEr2sPZB3jw+oXnp6rWuGeSVoO4eA=",
    patch_strip = 1,
    patches = ["//bazel/patches/xla:remove_stablehlo_source_location.patch"],
    strip_prefix = "xla-a3020310bebc39d1c258d1fb8f30b81fa4387cbc",
    urls = ["https://github.com/openxla/xla/archive/a3020310bebc39d1c258d1fb8f30b81fa4387cbc.tar.gz"],
)

archive_override(
    module_name = "rules_ml_toolchain",
    integrity = "sha256-izPVqzV2I7ox7EYzRzcRY6ogeLcHUr4LRP2xMrkWh6A=",
    patch_strip = 1,
    patches = ["//bazel/patches/rules_ml_toolchain:remove_experimental_include.patch"],
    strip_prefix = "rules_ml_toolchain-236a498d8624bef88e35ce2518a833204b0db19f",
    urls = ["https://github.com/google-ml-infra/rules_ml_toolchain/archive/236a498d8624bef88e35ce2518a833204b0db19f.tar.gz"],
)

archive_override(
    module_name = "googletest",
    integrity = "sha256-8lPKGgcmL4796DKOSyxol55A3fz8AB9w0dX2EsfeKXQ=",
    strip_prefix = "googletest-28e9d1f26771c6517c3b4be10254887673c94018",
    urls = ["https://github.com/google/googletest/archive/28e9d1f26771c6517c3b4be10254887673c94018.zip"],
)

##############################################################
# Dependencies defined in XLA via module extensions
##############################################################

### TSL
tsl_extension = use_extension("@xla//third_party/extensions:tsl.bzl", "tsl_extension")
use_repo(tsl_extension, "tsl")

llvm = use_extension("@xla//third_party/extensions:llvm.bzl", "llvm_extension")
use_repo(llvm, "llvm-project")

### C++ dependencies
# TODO: convert them to Bazel modules (bazel_dep).
third_party = use_extension("@xla//third_party/extensions:third_party.bzl", "third_party_ext")
use_repo(
    third_party,
    "dlpack",
    "eigen_archive",
    "gloo",
    "highwayhash",
    "nanobind",
    "shardy",
    "stablehlo",
    "triton",
)

# Python extension
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(
    python_version = DEFAULT_PYTHON_VERSION,
    python_version_env = "HERMETIC_PYTHON_VERSION",
)

[python.toolchain(
    python_version = v,
) for v in _CPYTHON_MINOR_VERSIONS]

[use_repo(
    python,
    "python_" + v.replace(".", "_"),
) for v in _CPYTHON_MINOR_VERSIONS]

# Pip extension
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Shared torch pip-hub configuration, factored out so the default hub and the
# per-version hubs below cannot drift. Every torch hub exposes the same split
# libtorch aliases, fetches from the same indexes, and applies the same wheel
# modifications; only hub_name and requirements_lock differ.
_TORCH_HUB_ALIASES = {
    "torch": [
        "torch_headers",
        "torch_libs",
        "libc10",
        "libtorch_cpu",
        "libtorch_python",
        "libtorch",
        "libshm",
        "libtorch_global_deps",
    ],
}

_TORCH_BASE_PIP_ARGS = [
    "--index-url",
    "https://pypi.org/simple",
    "--timeout",
    "120",  # seconds
    "--retries",
    "5",
]

_TORCH_EXTRA_PIP_ARGS = _TORCH_BASE_PIP_ARGS + [
    "--extra-index-url",
    "https://download.pytorch.org/whl/cpu",
]

_TORCH_WHL_MODIFICATIONS = {
    "//bazel:torch_wheel.json": "torch",
}

[pip.parse(
    extra_hub_aliases = _TORCH_HUB_ALIASES,
    extra_pip_args = _TORCH_EXTRA_PIP_ARGS,
    hub_name = "torch_tpu_pypi",
    python_version = python_version,
    requirements_lock = "//requirements:requirements_{}.txt".format(python_version.replace(".", "_")),
    target_platforms = _TARGET_PLATFORMS_BY_PYTHON[python_version],
    whl_modifications = _TORCH_WHL_MODIFICATIONS,
) for python_version in _CPYTHON_MINOR_VERSIONS]

# Additional PyTorch versions for the multi-ABI wheel. The default hub above
# provides the default torch version (via requirements_{py}.txt) plus the whole
# runtime environment. A per-version glue is only *compiled and linked* against
# PyTorch itself -- the rest of the environment is ABI-independent and shared --
# so each extra version only needs the torch wheel, locked on its own in a small
# torch-only requirements file.
#
# Single source of truth: //bazel:pytorch_versions.bzl (EXTRA_PYTORCH_VERSIONS).
# MODULE.bazel cannot load() Starlark, so -- exactly like SUPPORTED_PYTHON_VERSIONS
# above -- this list is kept in sync by hand. requirements/lock_environments.sh
# reads the same .bzl to regenerate the torch-only locks.
EXTRA_PYTORCH_VERSIONS = [
    "2.12.0",
    "2.13.0",
    "2.14.0",
]

# The release version the nightly channel currently leads up to. Its glue's
# torch comes from the same machinery as the extra release versions -- hub
# torch_tpu_pypi_2_16_0 -- except that it resolves from the nightly index and
# its lock is requirements_torch_nightly.txt (a dev-build pin refreshed by
# re-running requirements/lock_environments.sh). Kept in sync with
# NIGHTLY_TORCH_VERSION/GLUE_TORCH_VERSIONS in //bazel:pytorch_versions.bzl,
# like the list above.
NIGHTLY_TORCH_VERSION = "2.16.0"

EXTRA_GLUE_TORCH_VERSIONS = EXTRA_PYTORCH_VERSIONS + [NIGHTLY_TORCH_VERSION]

_TORCH_NIGHTLY_EXTRA_PIP_ARGS = _TORCH_BASE_PIP_ARGS + [
    "--extra-index-url",
    "https://download.pytorch.org/whl/nightly/cpu",
]

[pip.parse(
    extra_hub_aliases = _TORCH_HUB_ALIASES,
    extra_pip_args = _TORCH_NIGHTLY_EXTRA_PIP_ARGS if torch_version == NIGHTLY_TORCH_VERSION else _TORCH_EXTRA_PIP_ARGS,
    hub_name = "torch_tpu_pypi_" + torch_version.replace(".", "_"),
    python_version = python_version,
    # A single torch-only lock lists every wheel for the version; pip selects the
    # one matching each Python version at fetch time. The nightly channel's lock
    # keeps a channel name rather than a version name: its pin rolls to whatever
    # dev build is newest, so the version lives inside the file, not in its name.
    requirements_lock = "//requirements:requirements_torch_{}.txt".format(
        "nightly" if torch_version == NIGHTLY_TORCH_VERSION else torch_version.replace(".", "_"),
    ),
    # requirements_torch_nightly.txt is unhashed and the PyTorch nightly index
    # does not publish #sha256= fragments on its HTML links, so skip SimpleAPI
    # for the nightly hub and let pip fetch the wheel when requested.
    simpleapi_skip = ["torch"] if torch_version == NIGHTLY_TORCH_VERSION else [],
    target_platforms = _TARGET_PLATFORMS_BY_PYTHON[python_version],
    whl_modifications = _TORCH_WHL_MODIFICATIONS,
) for torch_version in EXTRA_GLUE_TORCH_VERSIONS for python_version in _CPYTHON_MINOR_VERSIONS]

_TORCH_CUDA_EXTRA_PIP_ARGS = _TORCH_BASE_PIP_ARGS

[pip.parse(
    extra_hub_aliases = _TORCH_HUB_ALIASES,
    extra_pip_args = _TORCH_CUDA_EXTRA_PIP_ARGS,
    hub_name = "torch_tpu_cuda_pypi",
    python_version = python_version,
    requirements_lock = "//requirements:requirements_cuda_{}.txt".format(python_version.replace(".", "_")),
    target_platforms = _TARGET_PLATFORMS_BY_PYTHON[python_version],
    whl_modifications = _TORCH_WHL_MODIFICATIONS,
) for python_version in _CPYTHON_MINOR_VERSIONS]

# Expose the pip repositories using the names your BUILD files expect
use_repo(pip, pypi = "torch_tpu_pypi")
use_repo(pip, pypi_cuda = "torch_tpu_cuda_pypi")

[use_repo(
    pip,
    **{
        "pypi_torch_" + tv.replace(".", "_"): "torch_tpu_pypi_" + tv.replace(".", "_"),
    }
) for tv in EXTRA_GLUE_TORCH_VERSIONS]

# Custom repository rules
torch_local_repo = use_repo_rule("//bazel:torch_local_repo.bzl", "torch_local_repo")

torch_local_repo(
    name = "local_torch",
)

torch_tpu_version_repo = use_repo_rule("//bazel:wheel_version.bzl", "torch_tpu_version_repo")

torch_tpu_version_repo(
    name = "torch_tpu_version",
    pyproject_toml = "//:pyproject.toml",
)

# The per-version glue pywrap packages for the multi-ABI wheel, generated from
# GLUE_TORCH_VERSIONS so adding a PyTorch version needs no new checked-in
# packages. See //bazel:glue_packages.bzl.
glue_packages = use_repo_rule("//bazel:glue_packages.bzl", "glue_packages")

glue_packages(
    name = "torch_tpu_glues",
)

# The ops_test GPU golden files, fetched from GCS as pinned by
# tests/goldens.pin so that Bazel downloads them once per invocation (and
# caches them by checksum) instead of every test shard pulling them at runtime.
# See //bazel:goldens.bzl.
goldens_repo = use_repo_rule("//bazel:goldens.bzl", "goldens_repo")

goldens_repo(
    name = "torch_tpu_goldens",
    pin_file = "//tests:goldens.pin",
)

# Load and run the custom extension
torch_tpu_ext = use_extension("//bazel:extensions.bzl", "torch_tpu_deps_ext")

# Expose the generated repository to your BUILD files
use_repo(torch_tpu_ext, "torch_tpu_deps")

# RBE
rbe_config = use_extension("@xla//third_party/extensions:rbe_config.bzl", "rbe_config_ext")
use_repo(rbe_config, "ml_build_config_platform")

# Ensure Bazel securely mounts the ThreadSanitizer runtime library into the RBE sandbox runfiles.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "tsan_lib",
    downloaded_file_path = "libclang_rt.tsan.so",
    sha256 = "4495aec33d1d6b56785af7d36d2b3b1801ece4ff53db43fc83a2a7fcede97dfe",
    urls = ["https://storage.googleapis.com/ml-sysroot-testing/python/libclang_rt.tsan-llvm20-20260511.so"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "jax_tpu_embedding",
    sha256 = "264047b40dcded934b91670c5d4ea08bead6e7f00d9b517746bc7fa8234be03d",
    strip_prefix = "jax-tpu-embedding-9772781da67c3d39d87f52d184f4f179043726bd",
    urls = ["https://github.com/jax-ml/jax-tpu-embedding/archive/9772781da67c3d39d87f52d184f4f179043726bd.tar.gz"],
)
