# proto-file: https://github.com/google-ml-infra/bap/blob/main/bap_proto/benchmark_registry.proto
# proto-message: BenchmarkSuite

benchmarks {
  name: "torch_benchmarks_shard_00_of_16"
  description: "Torch benchmarks shard 00 of 16"
  owner: "TorchTPU"

  workload {
    action: "./user_repo/.github/actions/run-benchmark"
    action_inputs { key: "script" value: "perflab/torch_benchmark_test.py" }
    action_inputs { key: "runtime_flags" value: "--run_scope=full --count_flops" }
    action_inputs { key: "env_vars" value: "TEST_TOTAL_SHARDS=16,TEST_SHARD_INDEX=0" }
  }

  environment_configs {
    id: "tpu-v7"
    runner_label: "linux-x86-tpu7x-224-4tpu"
    container_image: "us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build:latest@sha256:dddf008479144c57182b56a6d00bfc1f38f8f2ef206e2bc26ff6c0a401ded47e"
    workload_action_inputs { key: "torch_index" value: "https://download.pytorch.org/whl/cpu" }
    workload_action_inputs { key: "torch_spec" value: "torch==2.14.0" }
    workload_action_inputs { key: "libtpu_spec" value: "libtpu==0.0.50" }
    workload_action_inputs { key: "env_vars_hw" value: "BENCHMARK_PLATFORM=v7_1x1x1" }
  }

  environment_configs {
    id: "gpu-b200"
    runner_label: "linux-x86-a4-224-b200-8gpu"
    container_image: "us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build-cuda13.2-cudnn9.15:latest"
    workload_action_inputs { key: "torch_spec" value: "torch==2.14.0" }
    workload_action_inputs { key: "env_vars_hw" value: "BENCHMARK_PLATFORM=b200_1,TORCH_DEVICE_BACKEND_AUTOLOAD=0,TPU_SKIP_MDS_QUERY=1" }
  }

  metrics { pattern: ".*/post_warmup_step_time_seconds$" unit: "s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/post_warmup_step_time_ms$" unit: "ms" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/average_post_warmup_device_time_seconds$" unit: "s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/average_post_warmup_device_time_ms$" unit: "ms" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/first_step_time_seconds$" unit: "s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/first_step_time_ms$" unit: "ms" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/warmup_overhead_seconds$" unit: "s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/warmup_overhead_ms$" unit: "ms" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/wall_time$" unit: "s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/peak_device_memory_mb$" unit: "MB" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/num_warmup_steps$" unit: "count" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/succeeded$" unit: "bool" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/skipped$" unit: "bool" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/out_of_memory$" unit: "bool" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/batch_size$" unit: "count" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/seq_len$" unit: "count" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/samples_per_step$" unit: "count" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/tokens_per_step$" unit: "count" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/samples_per_second$" unit: "samples_per_s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/device_samples_per_second$" unit: "samples_per_s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/tokens_per_second$" unit: "tokens_per_s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/device_tokens_per_second$" unit: "tokens_per_s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/mfu$" unit: "ratio" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/device_mfu$" unit: "ratio" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/model_flops_per_step$" unit: "flops" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/achieved_tflops_per_second$" unit: "tflops" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/device_achieved_tflops_per_second$" unit: "tflops" stats { stat: LAST_VALUE } }
}

