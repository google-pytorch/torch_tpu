# proto-file: https://github.com/google-ml-infra/bap/blob/main/bap_proto/benchmark_registry.proto
# proto-message: BenchmarkSuite
#
# Full-scope sweep of the torch benchmark harness
# (examples/benchmarks/e2e/harness/torch_benchmark_test.py), split into
# 16 shards per platform.
#
# Sharding is done by the test binary, not by bazel: `bazel run` refuses a
# target whose shard_count exceeds one, so //examples/benchmarks/e2e/harness:
# torch_benchmark_full declares no shard_count and each job instead passes
# TEST_TOTAL_SHARDS/TEST_SHARD_INDEX through --test_env, which absltest honors
# directly. Cases are assigned round-robin over the sorted case list, so shard
# membership shifts whenever the registry of benchmarks changes.
#
# TORCH_DEVICE_BACKEND_AUTOLOAD is disabled on the GPU environments only.
# examples/benchmarks/e2e/common.py requires that non-TPU platforms never let
# torch_tpu claim the single PrivateUse1 slot, and autoload claims it from
# `import torch`. The TPU environments must keep autoload on: unlike the older
# benchmark targets, this harness never calls torch_tpu._loader.load() itself,
# so autoload is what makes torch.device("tpu") resolve.
#
# Runtime state is passed with --test_env rather than --action_env on purpose:
# --action_env is part of every action's cache key, so a per-shard value there
# would give all 32 jobs distinct keys and defeat remote caching.

benchmarks {
  name: "torch_benchmarks_shard_00_of_16"
  description: "Full-scope torch harness benchmarks, shard 0 of 16."
  owner: "TorchTPU"

  workload {
    action: "./ml_actions/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//examples/benchmarks/e2e/harness:torch_benchmark_full" }
  }

  environment_configs {
    id: "tpu-v7"
    runner_label: "linux-x86-tpu7x-224-4tpu"
    container_image: "us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build:latest@sha256:43c523372c4b7f7ce649a1ff204b908727bd338353303c0444af34cb305e5832"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=bench --test_sharding_strategy=disabled --test_env=BENCHMARK_PLATFORM=v7_1x1x1 --test_env=TEST_TOTAL_SHARDS=16 --test_env=TEST_SHARD_INDEX=0" }
    workload_action_inputs { key: "runtime_flags" value: "--run_scope=full" }
  }
  environment_configs {
    id: "gpu-b200-1"
    runner_label: "linux-x86-a4-224-b200-8gpu"
    container_image: "us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build-cuda13.2-cudnn9.15:latest"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=cuda --config=bench --test_sharding_strategy=disabled --test_env=BENCHMARK_PLATFORM=b200_1 --test_env=TORCH_DEVICE_BACKEND_AUTOLOAD=0 --test_env=TEST_TOTAL_SHARDS=16 --test_env=TEST_SHARD_INDEX=0" }
    workload_action_inputs { key: "runtime_flags" value: "--run_scope=full" }
  }

  metrics { name: "post_warmup_step_time_seconds" unit: "s" stats { stat: LAST_VALUE } }
  metrics { name: "first_step_time_seconds" unit: "s" stats { stat: LAST_VALUE } }
  metrics { name: "warmup_overhead_seconds" unit: "s" stats { stat: LAST_VALUE } }
  metrics { name: "peak_device_memory_mb" unit: "MB" stats { stat: LAST_VALUE } }
  metrics { name: "num_warmup_steps" unit: "count" stats { stat: LAST_VALUE } }
}
