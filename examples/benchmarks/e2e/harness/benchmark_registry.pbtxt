  description: "Layer performance benchmarks (without_cl) shard 02 of 08"
  owner: "TorchTPU"

  workload {
    action: "./user_repo/.github/actions/run-benchmark"
    action_inputs { key: "script" value: "examples/benchmarks/e2e/layer_performance_benchmarks.py" }
    action_inputs { key: "runtime_flags" value: "--enable_tensorboard_logging" }
    action_inputs { key: "env_vars" value: "TEST_TOTAL_SHARDS=8,TEST_SHARD_INDEX=2,TORCH_TPU_BENCH_BASE=1" }
  }

  environment_configs {
    id: "tpu-v7"
    runner_label: "linux-x86-tpu7x-224-4tpu"
    container_image: "us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build@sha256:30a9cf2ed330736957b3256dd3df69a13a556ae46626e9ad2ba205fa7a3c0051"
    workload_action_inputs { key: "torch_index" value: "https://download.pytorch.org/whl/cpu" }
    workload_action_inputs { key: "torch_spec" value: "torch==2.13.0" }
    workload_action_inputs { key: "libtpu_spec" value: "libtpu==0.0.47" }
    workload_action_inputs { key: "env_vars_hw" value: "BENCHMARK_PLATFORM=v7_1x1x1" }
  }

  metrics { pattern: ".*/post_warmup_step_time_seconds$" unit: "s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/post_warmup_step_time_ms$" unit: "ms" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/first_step_time_seconds$" unit: "s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/first_step_time_ms$" unit: "ms" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/warmup_overhead_seconds$" unit: "s" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/warmup_overhead_ms$" unit: "ms" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/peak_device_memory_mb$" unit: "MB" stats { stat: LAST_VALUE } }
  metrics { pattern: ".*/num_warmup_steps$" unit: "count" stats { stat: LAST_VALUE } }
}

