benchmarks {
  name: "torch_benchmarks_shard_00_of_16"
  description: "Full-scope torch harness benchmarks, shard 0 of 16."
  owner: "TorchTPU"

  workload {
    action: "./ml_actions/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//examples/benchmarks/e2e/harness:torch_benchmark_full" }
  }

  environment_configs {
    id: "tpu-v7"
    runner_label: "linux-x86-tpu7x-224-4tpu"
    container_image: "us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build:latest@sha256:43c523372c4b7f7ce649a1ff204b908727bd338353303c0444af34cb305e5832"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=bench --test_sharding_strategy=disabled --test_env=BENCHMARK_PLATFORM=v7_1x1x1 --test_env=TEST_TOTAL_SHARDS=16 --test_env=TEST_SHARD_INDEX=0" }
    workload_action_inputs { key: "runtime_flags" value: "--run_scope=full" }
  }
  environment_configs {
    id: "gpu-b200-1"
    runner_label: "linux-x86-a4-224-b200-8gpu"
    container_image: "us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build-cuda13.2-cudnn9.15:latest"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=cuda --config=bench --test_sharding_strategy=disabled --test_env=BENCHMARK_PLATFORM=b200_1 --test_env=TORCH_DEVICE_BACKEND_AUTOLOAD=0 --test_env=TEST_TOTAL_SHARDS=16 --test_env=TEST_SHARD_INDEX=0" }
    workload_action_inputs { key: "runtime_flags" value: "--run_scope=full" }
