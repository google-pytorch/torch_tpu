# proto-file: https://github.com/google-ml-infra/actions/blob/main/benchmarking/proto/benchmark_registry.proto
# proto-message: BenchmarkSuite
benchmarks {
  name: "test_llama_3_2_1b_forward_eager_default-hf_llama_3_2_1b"
  description: "Eager default forward pass benchmark for HuggingFace Llama 3.2 1B model."
  owner: "TorchTPU"

  workload {
    action: "./ml_actions/benchmarking/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//examples/benchmarks/e2e:model_performance_benchmarks" }
  }

  environment_configs {
    id: "tpu-v7"
    runner_label: "linux-x86-tpu7x-224-4tpu"
    container_image: "us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build:latest@sha256:43c523372c4b7f7ce649a1ff204b908727bd338353303c0444af34cb305e5832"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=bench --action_env=TESTBRIDGE_TEST_ONLY=test_llama_3_2_1b_forward_eager_default --test_sharding_strategy=disabled" }
    workload_action_inputs { key: "runtime_flags" value: "--enable_tensorboard_logging" }
  }

  metrics { name: "post_warmup_step_time_seconds" unit: "s" stats { stat: LAST_VALUE } }
  metrics { name: "first_step_time_seconds" unit: "s" stats { stat: LAST_VALUE } }
  metrics { name: "warmup_overhead_seconds" unit: "s" stats { stat: LAST_VALUE } }
  metrics { name: "peak_device_memory_mb" unit: "MB" stats { stat: LAST_VALUE } }
  metrics { name: "num_warmup_steps" unit: "count" stats { stat: LAST_VALUE } }
}
