load("@rules_python//python:py_test.bzl", "py_test")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")
load("//shims/py_rules:pytype.bzl", "pytype_strict_binary", "pytype_strict_library")

package(
    default_visibility = PACKAGE_DEFAULT_VISIBILITY,
)

pytype_strict_library(
    name = "filter_targets_lib",
    srcs = ["filter_targets.py"],
    imports = ["."],
)

pytype_strict_binary(
    name = "filter_targets",
    srcs = ["filter_targets.py"],
    main = "filter_targets.py",
    deps = [
        ":filter_targets_lib",
        "//shims/absl_py:app",
        "//shims/absl_py/logging",
    ],
)

py_test(
    name = "filter_targets_test",
    srcs = ["filter_targets_test.py"],
    python_version = "PY3",
    deps = [
        ":filter_targets_lib",
        "//shims/absl_py/testing:absltest",
    ],
)
