torch_tpu_cc_test(
    name = "traversal_test",
    srcs = ["traversal_test.cc"],
    exec_properties = {
        "cpp_link.mem": "16g",  # Needed for asan.
    },
    requires_libtpu = True,
    # Route to OSS TPU runners and exclude from OSS CPU runners
    # (running on CPU took 600+ sec due to emulated device init).
