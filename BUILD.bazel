load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@pypi//:requirements.bzl", "all_requirements", "requirement")
load("@xla//third_party/py:py_import.bzl", "py_import")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")
load(
    "//bazel:pytorch_versions.bzl",
    "EXTRA_PYTORCH_VERSIONS",
    "NIGHTLY_TORCH_VERSION",
    "SENTINEL_TORCH_VERSION",
)
load("//bazel:supported_python_versions.bzl", "SUPPORTED_PYTHON_VERSIONS")

package(
    default_visibility = PACKAGE_DEFAULT_VISIBILITY,
)

exports_files(["README.md"])

alias(
    name = "license",
    actual = "//torch_tpu:license",
)

filegroup(
    name = "pyproject",
    srcs = ["pyproject.toml"],
)

exports_files(["README.md"])

bool_flag(
    name = "test_wheel",
    build_setting_default = False,
)

config_setting(
    name = "wheel_test_enabled",
    flag_values = {":test_wheel": "True"},
    visibility = ["//visibility:public"],
)

# True when building (or testing) the pip wheel, which is always the versioned,
# separated layout. Set by `build:wheel_common` in .bazelrc. Bazel-only builds
# leave it False and are unaffected by the multi-version machinery.
bool_flag(
    name = "wheel_build",
    build_setting_default = False,
)

config_setting(
    name = "wheel_build_enabled",
    flag_values = {":wheel_build": "True"},
    visibility = ["//visibility:public"],
)

# The PyTorch version a C++ extension is compiled/linked against. The pybind
# transition (//shims/pybind11:pybind.bzl) sets this to build one glue per
# supported PyTorch version; shims/torch selects the matching torch wheel on it.
# Defaults to the sentinel ("no specific version"): the standard build and the
# default version's glue use the default pip hub's torch and never leave this
# configuration, so the pinning transitions reset to the default rather than
# diverge from it. Only ever set by transitions, never on the command line --
# a wheel build always builds every version.
string_flag(
    name = "_torch_version",
    build_setting_default = SENTINEL_TORCH_VERSION,
    visibility = ["//visibility:public"],
)

# Collapses the torch shims to headers-only: no libc10/libtorch_cpu is linked
# where this is True. Set by the backend-pinning transitions in
# shims/build_files/torch_version.bzl for everything routed into the shared XLA
# common library, which must never pull real torch -- a stray torch reference
# there would bind one version's ABI into the library every glue shares. The
# glues and their per-version torch commons leave it False and link the real
# torch matching their version. Only ever set by transitions, never on the
# command line.
bool_flag(
    name = "_torch_headers_only",
    build_setting_default = False,
)

config_setting(
    name = "torch_headers_only_enabled",
    flag_values = {":_torch_headers_only": "True"},
    visibility = ["//visibility:public"],
)

# One per extra (non-default) PyTorch version, plus the nightly channel.
# shims/torch keys its torch-wheel selection on these; the default build falls
# through to the existing python-version selection. Sourced from
# //bazel:pytorch_versions.bzl so the built versions stay in step with the pip
# hubs and the wheel glues.
[config_setting(
    name = "torch_" + tv.replace(".", "_"),
    flag_values = {":_torch_version": tv},
    visibility = ["//visibility:public"],
) for tv in EXTRA_PYTORCH_VERSIONS + [NIGHTLY_TORCH_VERSION]]

# Whether the wheel bundles the nightly glue alongside the release glues. On by
# default (presubmits and the nightly channel build with it); release artifacts
# are built with --config wheel_release, which turns it off so nothing built
# against a transient nightly snapshot ships to PyPI.
bool_flag(
    name = "include_nightly_glue",
    build_setting_default = True,
)

config_setting(
    name = "nightly_glue_included",
    flag_values = {":include_nightly_glue": "True"},
    visibility = ["//visibility:public"],
)

# The Python-version rows only apply to the default torch version (which
# builds at the sentinel); the extra versions are selected on //:_torch_version
# alone (see //shims/torch). Pinning the torch version here keeps these
# mutually exclusive with the //:torch_<v> settings, so a glue transitioned to
# an extra version under a wheel-test build (whose top-level PYTHON_VERSION
# leaks into the transitioned config) does not match both rows and trip an
# "ambiguous match" on the torch shim selects.
[config_setting(
    name = "wheel_test_" + v.replace(".", "_"),
    define_values = {"PYTHON_VERSION": v},
    flag_values = {
        ":test_wheel": "True",
        ":_torch_version": SENTINEL_TORCH_VERSION,
    },
    visibility = ["//visibility:public"],
) for v in SUPPORTED_PYTHON_VERSIONS]

[filegroup(
    name = "local_wheel_file_" + v.replace(".", ""),
    srcs = glob(["dist/torch_tpu*cp" + v.replace(".", "") + "*.whl"]),
) for v in SUPPORTED_PYTHON_VERSIONS]

[genrule(
    name = "pick_single_wheel_" + v.replace(".", ""),
    srcs = [":local_wheel_file_" + v.replace(".", "")],
    outs = ["selected_" + v.replace(".", "") + ".whl"],
    cmd = "cp $$(echo $(SRCS) | tr ' ' '\\n' | sort | tail -n 1) $@",
) for v in SUPPORTED_PYTHON_VERSIONS]

# Combined config setting for ease of use in selects
config_setting(
    name = "wheel_test_with_local_torch",
    # Pinning the torch version keeps these a strict specialization of the
    # sentinel-pinned //:wheel_test_<v> rows (which gained the pin in the
    # multi-ABI wheel change), so a local-torch wheel-test env select() picks
    # the local row instead of tripping an "ambiguous match" against them.
    flag_values = {
        ":test_wheel": "True",
        ":_torch_version": SENTINEL_TORCH_VERSION,
        "//shims/torch:local_torch": "True",
    },
)

[config_setting(
    name = "wheel_test_with_local_torch_" + v.replace(".", "_"),
    define_values = {"PYTHON_VERSION": v},
    flag_values = {
        ":test_wheel": "True",
        ":_torch_version": SENTINEL_TORCH_VERSION,
        "//shims/torch:local_torch": "True",
    },
    visibility = ["//visibility:public"],
) for v in SUPPORTED_PYTHON_VERSIONS]

filegroup(
    name = "torch_libs_mapped",
    srcs = select({
        "//ci/wheel:use_local_torch": [
            "@local_torch//:libc10_file",
            "@local_torch//:libshm_file",
            "@local_torch//:libtorch_cpu_file",
            "@local_torch//:libtorch_file",
            "@local_torch//:libtorch_global_deps_file",
            "@local_torch//:libtorch_python_file",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "torch_py_mapped",
    srcs = select({
        "//ci/wheel:use_local_torch": ["@local_torch//:torch_py_files"],
        "//conditions:default": [],
    }),
)

# 3. Assemble everything into the final zip using a robust procedural approach
genrule(
    name = "wheel_extra_test_deps",
    testonly = True,
    srcs = [
        "//examples:wheel_test_site_packages_recursive",
        "//tests:wheel_test_site_packages_recursive",
        "//torch_tpu/_internal/distributed:spmd_util",
        "//torch_tpu/_internal/utils:test_fixtures",
    ] + select({
        "//ci/wheel:use_local_torch": [
            ":torch_libs_mapped",
            ":torch_py_mapped",
        ],
        "//conditions:default": [],
    }),
    outs = ["wheel_extra_test_deps.zip"],
    cmd = "$(location //bazel:assemble_wheel_deps) $@ $(SRCS)",
    tools = ["//bazel:assemble_wheel_deps"],
)

_WHEEL_SELECT = {
    ":wheel_test_" + v.replace(".", "_"): ":pick_single_wheel_" + v.replace(".", "")
    for v in SUPPORTED_PYTHON_VERSIONS
}

_WHEEL_SELECT["//conditions:default"] = "//ci/wheel:torch_tpu_wheel"

py_import(
    name = "torch_tpu_py_import",
    testonly = True,
    wheel = select(_WHEEL_SELECT),
    zip_deps = [":wheel_extra_test_deps"],
    # Add requirements coming from pip_parse from workspace
    deps = select({
        "//ci/wheel:use_local_torch": [
            "@local_torch//:torch",
        ] + [
            req
            for req in all_requirements
            if req != requirement("torch")
        ],
        "//conditions:default": all_requirements,
    }),
)

genrule(
    name = "debug_wheel_flag",
    outs = ["wheel_status.txt"],
    cmd = select({
        ":wheel_test_enabled": "echo 'WHEEL_TEST IS ENABLED (Matched)' > $@",
        "//conditions:default": "echo 'WHEEL_TEST IS NOT ENABLED (Did not match)' > $@",
    }),
)

