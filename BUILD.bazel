load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@pypi//:requirements.bzl", "all_requirements", "requirement")
load("@xla//third_party/py:py_import.bzl", "py_import")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")

package(
    default_visibility = PACKAGE_DEFAULT_VISIBILITY,
)

alias(
    name = "license",
    actual = "//torch_tpu:license",
)

filegroup(
    name = "pyproject",
    srcs = ["pyproject.toml"],
)

exports_files(["README.md"])

bool_flag(
    name = "test_wheel",
    build_setting_default = False,
)

config_setting(
    name = "wheel_test_enabled",
    flag_values = {":test_wheel": "True"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "use_prebuilt_wheel",
    flag_values = {":test_wheel": "True"},
    visibility = ["//visibility:public"],
)

filegroup(
    name = "local_wheel_file",
    srcs = glob(["dist/torch_tpu*.whl"]),
)

# Combined config setting for ease of use in selects
config_setting(
    name = "wheel_test_with_local_torch",
    define_values = {"TORCH_SOURCE": "local"},
    flag_values = {":test_wheel": "True"},
)

filegroup(
    name = "torch_libs_mapped",
    srcs = [
        "@local_torch//:libc10_file",
        "@local_torch//:libshm_file",
        "@local_torch//:libtorch_cpu_file",
        "@local_torch//:libtorch_file",
        "@local_torch//:libtorch_global_deps_file",
        "@local_torch//:libtorch_python_file",
    ],
)

filegroup(
    name = "torch_py_mapped",
    srcs = ["@local_torch//:torch_py_files"],
)

# 3. Assemble everything into the final zip using a robust procedural approach
genrule(
    name = "wheel_extra_test_deps",
    testonly = True,
    srcs = [
        "//examples:all_py_files_recursive",
        "//tests:all_py_files_recursive",
        "//torch_tpu/_internal/distributed:spmd_util",
        "//torch_tpu/_internal/utils:test_fixtures",
    ] + select({
        "//ci/wheel:use_local_torch": [
            ":torch_libs_mapped",
            ":torch_py_mapped",
        ],
        "//conditions:default": [],
    }),
    outs = ["wheel_extra_test_deps.zip"],
    cmd = "$(location //bazel:assemble_wheel_deps) $@ $(SRCS)",
    tools = ["//bazel:assemble_wheel_deps"],
)

py_import(
    name = "torch_tpu_py_import",
    testonly = True,
    wheel = select({
        "//:use_prebuilt_wheel": ":local_wheel_file",
        "//conditions:default": "//ci/wheel:torch_tpu_wheel",
    }),
    zip_deps = [":wheel_extra_test_deps"],
    # Add requirements coming from pip_parse from workspace
    deps = select({
        "//ci/wheel:use_local_torch": [
            "@local_torch//:torch",
        ] + [
            req
            for req in all_requirements
            if req != requirement("torch")
        ],
        "//conditions:default": all_requirements,
    }),
)

genrule(
    name = "debug_wheel_flag",
    outs = ["wheel_status.txt"],
    cmd = select({
        ":wheel_test_enabled": "echo 'WHEEL_TEST IS ENABLED (Matched)' > $@",
        "//conditions:default": "echo 'WHEEL_TEST IS NOT ENABLED (Did not match)' > $@",
    }),
)
