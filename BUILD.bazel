load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@pypi//:requirements.bzl", "all_requirements")
load("@xla//third_party/py:py_import.bzl", "py_import")
load("//:visibility.bzl", "PACKAGE_DEFAULT_VISIBILITY")
load("//ci:integrity.bzl", "wheel_integrity_test")

package(
    default_visibility = PACKAGE_DEFAULT_VISIBILITY,
)

alias(
    name = "license",
    actual = "//torch_tpu:license",
)

filegroup(
    name = "pyproject",
    srcs = ["pyproject.toml"],
)

exports_files(["README.md"])

bool_flag(
    name = "test_wheel",
    build_setting_default = False,
)

config_setting(
    name = "wheel_test_enabled",
    flag_values = {":test_wheel": "True"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "use_prebuilt_wheel",
    flag_values = {":test_wheel": "True"},
    visibility = ["//visibility:public"],
)

filegroup(
    name = "local_wheel_file",
    srcs = glob(["dist/*.whl"]),
)

py_import(
    name = "torch_tpu_py_import",
    testonly = True,
    wheel = select({
        "//:use_prebuilt_wheel": ":local_wheel_file",
        "//conditions:default": "//ci/wheel:torch_tpu_wheel",
    }),
    # Add requirements coming from pip_parse from workspace
    deps = all_requirements,
)

genrule(
    name = "debug_wheel_flag",
    outs = ["wheel_status.txt"],
    cmd = select({
        ":wheel_test_enabled": "echo 'WHEEL_TEST IS ENABLED (Matched)' > $@",
        "//conditions:default": "echo 'WHEEL_TEST IS NOT ENABLED (Did not match)' > $@",
    }),
)

# Integrity check for wheel dependencies of OSS tests.
# This ensures that all internal libraries required by tests are
# accounted for in the wheel.
wheel_integrity_test(
    name = "wheel_integrity_test",
    allowed_targets = [
        "//ci/wheel:all_torch_tpu_files",
    ],
    tests = [
        "//...",
    ],
)
