
# DO NOT SUBMIT: temporary comment to trigger full OSS presubmit run.
# Show various config startup information to aid debugging.
common --announce_rc

# TODO: b/431034055 - XLA doesn't give visiblity to some pjrt targets.
# As a work around, disable visibility checking.
common --check_visibility=false

# `//build_files:test_rbe_macro_exec_properties` analyzes its `torch_tpu_py_test`
# subjects under both values of `//:_rbe_test_execution`, and each subject pulls
# in `:torch_tpu_wheel`. Under the wheel test configs this exceeds Bazel's
# default limit of 2000 dependency edges for analysis tests that use
# configuration transitions (6596 edges as of 2026-09-30), which breaks
# analyzing all targets, as `bazel-diff generate-hashes` does in CI.
common --analysis_testing_deps_limit=16000

# The default comes form XLA's setup, which is 3.13,
# while we have 3.14 configured.
common --repo_env=HERMETIC_PYTHON_VERSION=3.14

common --enable_bzlmod=true --enable_workspace=false

# Config to enable legacy WORKSPACE. Use with --config=workspace.
common:workspace --enable_bzlmod=false
common:workspace --enable_workspace=true
# Support legacy WORKSPACE-style repository paths.
common:workspace --per_file_copt=external/(onednn|llvm-project)/.*[.](cc|cpp|hpp)$@-std=c++17

# Enable usage of pywrap rules for pybind_extension.
common --repo_env=USE_PYWRAP_RULES=1

# The XLA repo uses repository rules with remotable=True.
common --experimental_repo_remote_exec

# Disable Python output buffering so that, if C++ crashes the
# process, buffered output doesn't go missing (e.g. print
# statements for debugging).
common --test_env=PYTHONUNBUFFERED=1

common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --incompatible_strict_action_env=true

# Needed for setting C++ standard to C++20.
common --enable_platform_specific_config

# Use C++20 by default, but not for `.c` files. Clang 18
# gives an error when C files use it.
common --per_file_copt=.*[.](cc|cpp|hpp)$@-std=c++20
# Use C++17 for dependencies incompatible with C++20.
# Since the last flag wins for a given file, this comes after
# the above flag.
# Support Bzlmod-style mangled repository paths.
common --per_file_copt=external/.*(onednn|llvm-project).*[.](cc|cpp|hpp)$@-std=c++17

# Treat warnings as errors.
build --copt=-Werror

# Default to optimized (-c opt) builds in OSS.
build --compilation_mode=opt

# ===== Start spammy C++ compile warning disables =====
# Some low-level legacy glibc macros are used in lots of
# places, which very spammy, so silence this one.
build --per_file_copt=".*@-Wno-#pragma-messages"
build --per_file_copt=.*@-Wno-deprecated-declarations
# NOTE: Absl and Torch both define LOG, DCHECk, etc macros.
# The two are *usually* source-compatible, but aren't always,
# and it can manifest is weird ways in far away dependencies.
build --per_file_copt=.*@-Wno-macro-redefined
build --per_file_copt=.*@-Wno-defaulted-function-deleted
build --per_file_copt=.*@-Wno-unused-command-line-argument
build --host_copt=-Wno-unused-command-line-argument
build --linkopt=-Wno-unused-command-line-argument
build --host_linkopt=-Wno-unused-command-line-argument
build --per_file_copt=.*@-Wno-return-type

# Disable warnings from external dependencies for both the target product and
# the build-time host tools, which we can't do anything about and are very
# spammy.
# NOTE: Some warnings may be due to external dependencies, but
# get reported as originating from torch_tpu code. Those need
# to be ignored using a plain `.*` match.
build --per_file_copt=.*external/.*@-w
build --host_per_file_copt=.*external/.*@-w

# Disable warnings globally for both target and host builds.
# We do this because the following warnings occur from external dependencies
# (primarily OpenXLA, Abseil, and RE2) during the compilation of our local
# files, and `--per_file_copt=.*external.*@-w` and
# `build --host_per_file_copt=.*external/.*@-w` above cannot catch them.
# We accept the trade-off of losing these specific checks on our own code in
# order to prevent these third-party headers from causing massive log bloat and
# crashing the browser.
#
# To avoid massive spam from OpenXLA headers missing _Nonnull/_Nullable.
build --copt=-Wno-nullability-completeness
build --host_copt=-Wno-nullability-completeness
# To avoid spam from RE2/Abseil and OpenXLA headers using deprecated macros/locks.
build --copt=-Wno-deprecated-declarations
build --host_copt=-Wno-deprecated-declarations
# To avoid spam from third-party unused functions and variables.
build --copt=-Wno-unused-function
build --host_copt=-Wno-unused-function
build --copt=-Wno-unused-value
build --host_copt=-Wno-unused-value

# ===== End spammy C++ compile warning disables ===

# Set C++ standard to C++20.
# The clang wrapper inside rules_ml_toolchain uses a hardcoded sysroot of
# linux_glibc_2_27, which maps to c++17. We need to switch to linux_glibc_2_31
# to get C++20. See
# https://github.com/google-ml-infra/rules_ml_toolchain?tab=readme-ov-file#configure-the-llvm--sysroot-in-rules_ml_toolchain
# for details.
build --repo_env=LLVM_VERSION=20
build --repo_env=SYSROOT_DIST=linux_glibc_2_31
build --action_env=BAZEL_CXXOPTS="-std=c++20"

# The disk cache uses local disk as a "remote" cache backend, which can
# significantly speed up builds across server restarts and analysis cache
# wipes.
build --disk_cache=~/.cache/bazel/bazel-disk-cache
build --experimental_disk_cache_gc_max_age=90d
build --experimental_disk_cache_gc_max_size=100G

# Don't implicitly add repo roots to sys.path. This avoids top-level import
# name collisions.
# TODO: b/460162708 - This must be true because XNNPACK relies on its
# repo root being implicitly added to sys.path. Set this to false when
# XNNPACK is fixed.
build --experimental_python_import_all_repositories=true

# Use a downloader config to mirror GitHub and Python package downloads.
common --downloader_config=bazel_downloader.cfg

# llvm has a bug where an empty glob isn't explicitly set.
build --incompatible_disallow_empty_glob=false
# Using the //... wildcard forces Bazel's loading phase to evaluate every single
# BUILD file in the entire repository. The flag prefixed with `build` above only
# allows Bazel to suppress the empty glob crashes from commands `bazel build` or
# `bazel test`. Once we introduce `bazel query` commands, Bazel will execute the
# glob check, hit the empty packages and instantly crash.
query --incompatible_disallow_empty_glob=false

# Disable magic generation of `__init__.py` files. This avoids surprising
# import behaviors that only happen under Bazel.
build --incompatible_default_to_explicit_init_py=true

# Don't duplicate all the external dependency filesrunfiles under
# $runfiles/external.
build --legacy_external_runfiles=false

# Get notified of file changes to rehash them before the next build.
build --watchfs

# Some targets have the same py source file, but use different
# configurations via `requires-` tags. This results in an action
# conflict when precompiling. Disable to avoid that problem.
build --@rules_python//python/config_settings:precompile=force_disabled

# NOTE: the --config=faster settings may make builds faster, but at the cost of
# weaker correctness. If builds act weird, run `bazel clean` and/or remove
# the `--config=faster` setting to help clear the Bazel state.

# By default, jobs==cores, but much work is IO bound, so can scale higher.
build:faster --jobs=HOST_CPUS*20
# Skip checking if an e.g. genrule output was changed manually.
build:faster --experimental_check_output_files=false
# Bazel 9 feature: skip checking files on the local host.
# build:faster --experimental_check_external_other_files=false

# ThreadSanitizer (TSan) Configurations
# Base TSan config for C++ tests.
common:tsan_cc --features=tsan
# Never strips debugging information from all binaries and shared libraries.
common:tsan_cc --strip=never
# Enables TSan to detect data races in C/C++ code at runtime.
common:tsan_cc --copt=-fsanitize=thread
common:tsan_cc --linkopt=-fsanitize=thread
# Generates DWARF debugging information so TSan prints filenames and line
# numbers.
common:tsan_cc --copt=-g
# Keeps frame pointers intact for fast, accurate stack unwinding in error
# reports.
common:tsan_cc --copt=-fno-omit-frame-pointer
# Defines a macro allowing developers to write `#ifdef THREAD_SANITIZER` in C++
# to selectively disable flaky code or use explicit TSan annotations.
common:tsan_cc --copt=-DTHREAD_SANITIZER
# TSan executes exceptionally slowly at -O0. -O1 applies basic optimizations to
# speed up execution without aggressively inlining and destroying the call stack
# structure.
common:tsan_cc --copt=-O1
# Disable tcmalloc linking/preloading under TSan so TSan's allocator interceptor
# operates without conflict, even if LD_PRELOAD is set in the container environment.
build:tsan_cc --//:_tsan_build=True
test:tsan_cc --test_env=LD_PRELOAD=

# TSan config for Python tests.
# Explicitly uses dynamic linking (-shared-libsan) so the PyTorch C++ extension
# leaves its TSan symbols undefined, allowing our LD_PRELOAD wrapper to satisfy
# them at runtime via the custom Python interpreter.
common:tsan_py --config=tsan_cc
build:tsan_py --config=tsan_cc
test:tsan_py --config=tsan_cc
common:tsan_py --copt=-shared-libsan
common:tsan_py --linkopt=-shared-libsan
# Hermetic Python Configuration for TSan (Python 3.12)
# Standard Python generates thousands of false-positive data races due to the
# GIL. This overrides the default rules_ml_toolchain behavior to fetch a custom
# Python interpreter built natively with LLVM 20 TSan instrumentation.
common:tsan_py --repo_env=HERMETIC_PYTHON_VERSION=3.12
common:tsan_py --repo_env=HERMETIC_PYTHON_URL=https://storage.googleapis.com/ml-sysroot-testing/python/cpython-3.12.x-tsan-shared-linux-x86_64-llvm-20-bazel-20260511.tar.gz
common:tsan_py --repo_env=HERMETIC_PYTHON_SHA256=91db187fb5d98e6361b6416e81a6037dbe5ba745dc3e191ba1ffa06a3108e1b6
common:tsan_py --repo_env=HERMETIC_PYTHON_PREFIX=cpython-3.12.x-tsan-shared-linux-x86_64-llvm-20-bazel-20260511/

# Config to aid debugging.
# "standalone" means "local" -- run things locally so its easier to
# inspect state and break out of bazel sandboxes.
common:local --test_strategy=standalone
common:local --spawn_strategy=standalone
common:local --strategy=standalone
common:local --config=tpu_envvars

# Config for no_remote builds
common:no_rbe --config=local
common:no_rbe --remote_cache=
common:no_rbe --remote_executor=
common:no_rbe --google_default_credentials=false

# Useful when running a single test target and/or test
# case within the test.
common:testone --config=local
common:testone --test_output=streamed

# Config for when TPU is the target platform.
common:tpu_envvars --test_env=TPU_SKIP_MDS_QUERY
common:tpu_envvars --test_env=TPU_TOPOLOGY
common:tpu_envvars --test_env=TPU_WORKER_ID
common:tpu_envvars --test_env=TPU_TOPOLOGY_WRAP
common:tpu_envvars --test_env=TPU_CHIPS_PER_HOST_BOUNDS
common:tpu_envvars --test_env=TPU_ACCELERATOR_TYPE
common:tpu_envvars --test_env=TPU_RUNTIME_METRICS_PORTS
common:tpu_envvars --test_env=TPU_TOPOLOGY_ALT
common:tpu_envvars --test_env=TPU_HOST_BOUNDS
common:tpu_envvars --test_env=TPU_WORKER_HOSTNAMES
common:tpu_envvars --test_env=CHIPS_PER_HOST_BOUNDS
common:tpu_envvars --test_env=HOST_BOUNDS
# NOTE: This value can be host-specific and harmful to Bazel caching.
common:tpu_envvars --test_env=VBAR_CONTROL_SERVICE_URL

# Configs for Bazel remote caching. For security reasons, split configs into
# read-only and read-write to prevent cache poisoning / corruption by untrusted users.
#
# Only CI (or other trusted accounts) have write access to the cache. The setup
# follows that
#   - Local builds can read from the cache but cannot write to it.
#   - All CI builds (presubmit, postsubmit and nightly) can read from and write
#     to the cache.
# This ensures that CI runs contribute to the cache while untrusted local builds
# cannot affect it.
#
# See https://developers.google.com/remote-build-execution/docs/set-up/set-up-caching
# for more details.
common:remote_caching_readonly --remote_upload_local_results=false
common:remote_caching_readonly --remote_cache=grpcs://remotebuildexecution.googleapis.com
common:remote_caching_readonly --remote_instance_name=projects/ml-oss-rbe-testing/instances/default_instance
# Default platform cache silo key for standard readonly RBE remote caching.
common:remote_caching_readonly --extra_execution_platforms="//bazel/platforms:rbe_default_platform"
common:remote_caching_readonly --google_default_credentials

# Allow creation of resultstore URLs for ci bazel invocation, must be used in
# conjunction with an RBE or RBE cache write config.
common:resultstore_base --bes_backend=buildeventservice.googleapis.com
common:resultstore_base --bes_timeout=600s
common:resultstore_base --bes_results_url="https://source.cloud.google.com/results/invocations"
common:resultstore_base --bes_instance_name="ml-oss-rbe-testing"

common:remote_caching_readwrite --config=remote_caching_readonly
common:remote_caching_readwrite --remote_upload_local_results=true

common:remote_execution_readwrite --config=remote_execution_readonly
common:remote_execution_readwrite --remote_upload_local_results=true

# Configs for Bazel public caching.
common:public_caching_readonly --remote_upload_local_results=false
common:public_caching_readonly --remote_cache="https://storage.googleapis.com/torchtpu-bazel-cache/"

common:public_caching_readwrite --config=public_caching_readonly
common:public_caching_readwrite --remote_upload_local_results=true
common:public_caching_readwrite --google_default_credentials

# Configs for Bazel public caching for PyTorch/Helion.
common:helion_public_caching_readonly --remote_upload_local_results=false
common:helion_public_caching_readonly --remote_cache="https://storage.googleapis.com/torchtpu-bazel-cache-helion/"

common:helion_public_caching_readwrite --config=helion_public_caching_readonly
common:helion_public_caching_readwrite --remote_upload_local_results=true
common:helion_public_caching_readwrite --google_default_credentials

# Settings specific to CI runs.
common:ci --build_tests_only
common:ci --config=remote_execution_readwrite
common:ci --config=resultstore_base
common:ci --remote_download_minimal
common:ci --keep_going
test:ci --test_output=errors

# Enable ANSI color in CI logs.
#
# Intentionally override the default `--color=auto` because Bazel client
# sends `--isatty=0` when no terminal is available in GitHub Actions.
# Besides, turn off curses since the log viewer does not implement cursor-movement
# escapes.
#
# It only affects Bazel's own progress / diagnostic stream on stderr. Target
# lists, query results, and every other machine-readable payload written to
# stdout are still uncolored, so analyers like `bazel-diff` and `bazel query`
# keep parsing clean text.
common:ci --color=yes
common:ci --curses=no

# Setting specific to benchmarking runs.
common:bench --config=ci
common:bench --config=tpu_envvars
common:bench --strategy=TestRunner=standalone,local

# TODO: b/523216544 - Refactor all of this logic to avoid separate configs for
# every accelerator/job combination

# Settings specific to CPU CI runs.
common:ci_cpu --config=ci
common:ci_cpu --build_tag_filters=-nobuild,-requires-gpu,-requires-tpu,-cuda-build-test
common:ci_cpu --test_tag_filters=-nobuild,-notest,-requires-gpu,-requires-tpu,-cuda-build-test,-requires-newest-deps

# Settings specific to CPU presubmit.
common:ci_cpu_presubmit --config=ci_cpu
common:ci_cpu_presubmit --test_tag_filters=-nobuild,-notest,-requires-gpu,-requires-tpu,-nopresubmit,-cuda-build-test,-requires-newest-deps

# Settings for nightly runs on CPU.
common:ci_cpu_nightly --config=ci_cpu
common:ci_cpu_nightly --test_tag_filters=-nobuild,-notest,-requires-gpu,-requires-tpu,-nonightly,-cuda-build-test,-requires-newest-deps

# Settings specific to TPU CI runs.
common:ci_tpu_base --config=ci
common:ci_tpu_base --config=tpu_envvars
# Point VBAR_CONTROL_SERVICE_URL at the static Unix domain socket path mounted
# by the GKE TPU device plugin (/var/run/tpu-plugin/vbar.sock) instead of
# inheriting a potentially host-specific value from the runner environment, so
# different TPU runner VMs produce identical TestRunner cache keys.
# NOTE: TestRunner currently runs unsandboxed (standalone,local). If it is ever
# switched to a sandboxed strategy, add
# --sandbox_add_mount_pair=/var/run/tpu-plugin so the socket remains accessible
# inside the sandbox.
common:ci_tpu_base --test_env=VBAR_CONTROL_SERVICE_URL=unix:///var/run/tpu-plugin/vbar.sock
common:ci_tpu_base --build_tag_filters=-nobuild,requires-tpu-v5lite,requires-tpu-v5lite:4,requires-tpu-v5lite:8,requires-tpu-v5p,requires-tpu-v5p:4,requires-tpu-v6e,requires-tpu-v7x,requires-tpu-v7x:4,
common:ci_tpu_base --strategy=TestRunner=standalone,local
# TPU CI runs split `bazel build` and `bazel test` into two invocations:
# 1. `bazel build` compiles and links on RBE (tensorflow-testing) without
#    uploading local results, and downloads top-level test binaries + runfiles
#    to the local disk / disk cache.
# 2. `bazel test` runs TPU tests locally while reading and writing cached
#    TestRunner results in ml-oss-rbe-testing (where the TPU runner service
#    account has actionCacheWriter permissions).
common:ci_tpu_base --remote_download_toplevel
common:ci_tpu_base --remote_upload_local_results=false
test:ci_tpu_base --remote_instance_name=projects/ml-oss-rbe-testing/instances/default_instance
test:ci_tpu_base --remote_cache=grpcs://remotebuildexecution.googleapis.com
test:ci_tpu_base --remote_executor=
test:ci_tpu_base --remote_upload_local_results=true

# Settings for nightly runs on TPU.
common:ci_tpu_nightly --config=ci_tpu_base
common:ci_tpu_nightly --test_tag_filters=requires-tpu,-notest,-nobuild,-nonightly,-requires-newest-deps
common:ci_tpu_nightly --test_timeout=-1,-1,-1,4800
common:ci_tpu_nightly --local_test_jobs=8

# Settings for hardware-specific CI runs on TPU v5, v6, v7.
#
# Each of these configs sets --local_test_jobs to the chip count of the runner
# it is used on. TPU tests run under parallel_accelerator_execute.sh, which
# gives each test exclusive use of one chip, so the number of concurrent test
# jobs must not exceed the number of chips. Without an explicit value Bazel
# derives --local_test_jobs from --jobs, which remote_execution_readonly sets
# to 200: the excess tests would spin in the wrapper's one-second retry loop
# while their own test timeout ran down.
#
# The runner for each generation is fixed across every workflow that uses these
# configs (presubmit, postsubmit, local_torch, upstream, out-of-tree, wheel
# tests), so the counts below can be hardcoded. If that stops being true, these
# need to move to the individual workflows.

# Runs on linux-x86-ct5lp-224-8tpu.
common:ci_tpu_v5 --config=ci_tpu_base
common:ci_tpu_v5 --test_tag_filters=requires-tpu,-notest,-nobuild,-fails-on-tpu-v5,-requires-newest-deps
common:ci_tpu_v5 --local_test_jobs=8

common:ci_tpu_v5_presubmit --config=ci_tpu_v5
# Single-chip v5e presubmit tests run on RBE (see ci_rbe_presubmit), so the
# self-hosted 8-chip runner only runs multi-chip and no-remote-exec v5e tests.
common:ci_tpu_v5_presubmit --test_tag_filters=requires-tpu-v5lite:4,requires-tpu-v5lite:8,requires-tpu-v5p:4,no-remote-exec,-notest,-nobuild,-nopresubmit,-fails-on-tpu-v5,-presubmit-v6,-presubmit-v7,-requires-newest-deps

# Runs only the tests tagged `requires-newest-deps`, which need the newest
# supported dependencies (requirements/requirements_3_14_latest.txt). Every
# other CI config excludes them.
common:ci_tpu_v5_newest_deps --config=ci_tpu_v5
common:ci_tpu_v5_newest_deps --test_tag_filters=requires-newest-deps,-notest,-nobuild,-fails-on-tpu-v5

common:ci_tpu_v5_nightly --config=ci_tpu_v5
common:ci_tpu_v5_nightly --test_tag_filters=requires-tpu,-notest,-nobuild,-nonightly,-fails-on-tpu-v5,-requires-newest-deps
common:ci_tpu_v5_nightly --test_timeout=-1,-1,-1,4800

# Runs on linux-x86-ct6e-180-8tpu.
common:ci_tpu_v6 --config=ci_tpu_base
common:ci_tpu_v6 --test_tag_filters=requires-tpu,-notest,-nobuild,-fails-on-tpu-v6,-requires-newest-deps
common:ci_tpu_v6 --local_test_jobs=8

common:ci_tpu_v6_presubmit --config=ci_tpu_v6
common:ci_tpu_v6_presubmit --test_tag_filters=-notest,-nobuild,-nopresubmit,-fails-on-tpu-v6,presubmit-v6,-requires-newest-deps

# Runs on linux-x86-tpu7x-224-4tpu.
common:ci_tpu_v7 --config=ci_tpu_base
common:ci_tpu_v7 --test_tag_filters=requires-tpu,-notest,-nobuild,-fails-on-tpu-v7,-requires-newest-deps
common:ci_tpu_v7 --test_env=TORCH_TPU_ACCELERATOR_COUNT="4"
common:ci_tpu_v7 --test_env=ALLOW_MULTIPLE_LIBTPU_LOAD=true
common:ci_tpu_v7 --local_test_jobs=4

common:ci_tpu_v7_presubmit --config=ci_tpu_v7
common:ci_tpu_v7_presubmit --test_tag_filters=-notest,-nobuild,-nopresubmit,-fails-on-tpu-v7,presubmit-v7,-requires-newest-deps

common:ci_tpu_v7_nightly --config=ci_tpu_v7
common:ci_tpu_v7_nightly --test_tag_filters=requires-tpu,-notest,-nobuild,-nonightly,-fails-on-tpu-v7,-requires-newest-deps
common:ci_tpu_v7_nightly --test_timeout=-1,-1,-1,4800

# The TPU v7 counterpart of ci_tpu_v5_newest_deps.
common:ci_tpu_v7_newest_deps --config=ci_tpu_v7
common:ci_tpu_v7_newest_deps --test_tag_filters=requires-newest-deps,-notest,-nobuild,-fails-on-tpu-v7

# Setting TPU support true for profiler trace.
build --define=with_tpu_support=true

# Configs for Bazel remote execution.
# Do not use instance "projects/ml-oss-rbe-testing/instances/default_instance"
# because it does not have RBE agents setup.
common:remote_execution_readonly --remote_instance_name=projects/tensorflow-testing/instances/default_instance
common:remote_execution_readonly --google_default_credentials
common:remote_execution_readonly --remote_upload_local_results=false
common:remote_execution_readonly --jobs=200
common:remote_execution_readonly --remote_timeout=3600
common:remote_execution_readonly --test_timeout=3600
# This define is probably vestigial, but it's not entirely clear.
# Revisit removing this with Bazel 9.
common:remote_execution_readonly --define=EXECUTOR=remote
common:remote_execution_readonly --remote_executor=grpcs://remotebuildexecution.googleapis.com
# Use a custom platform to define the default `cache-silo-key` rather than
# --remote_default_exec_properties to prevent ImmutableMap duplicate-key crashes
# when configs are chained.
common:remote_execution_readonly --extra_execution_platforms="//bazel/platforms:rbe_default_platform"

# Dedicated Google Cloud RBE execution in us-west1. Build actions and CPU tests
# run on the default CPU pool. TPU tests pick their own pool per target (see
# build_files/build_defs.bzl).
common:rbe_test_execution --remote_executor=grpcs://us-west1-remotebuildexecution.googleapis.com
common:rbe_test_execution --remote_instance_name=projects/rbe-tpu-oss/instances/default_instance_west1
common:rbe_test_execution --bes_instance_name=rbe-tpu-oss
common:rbe_test_execution --extra_execution_platforms="//bazel/platforms:rbe_platform"
common:rbe_test_execution --google_default_credentials
common:rbe_test_execution --remote_upload_local_results=false
# Tests run remotely on RBE, not locally on the client, so skip building local
# .runfiles symlink trees across ~1,000 test targets (~4 min of local disk I/O).
common:rbe_test_execution --nobuild_runfile_links
common:rbe_test_execution --jobs=200
common:rbe_test_execution --remote_timeout=3600
# A hung test holds a TPU worker until it times out. The slowest test takes
# about 5 minutes on RBE, so 15 minutes fails hangs fast with plenty of margin.
common:rbe_test_execution --test_timeout=900
build:rbe_test_execution --//:_rbe_test_execution=True
# Override `tpu_envvars` so the client's TPU settings don't reach remote
# workers or change the cache key; TPU tests set their own values in rule env.
common:rbe_test_execution --test_env=TPU_SKIP_MDS_QUERY=
common:rbe_test_execution --test_env=TPU_TOPOLOGY=
common:rbe_test_execution --test_env=TPU_WORKER_ID=
common:rbe_test_execution --test_env=TPU_TOPOLOGY_WRAP=
common:rbe_test_execution --test_env=TPU_CHIPS_PER_HOST_BOUNDS=
common:rbe_test_execution --test_env=TPU_ACCELERATOR_TYPE=
common:rbe_test_execution --test_env=TPU_RUNTIME_METRICS_PORTS=
common:rbe_test_execution --test_env=TPU_TOPOLOGY_ALT=
common:rbe_test_execution --test_env=TPU_HOST_BOUNDS=
common:rbe_test_execution --test_env=TPU_WORKER_HOSTNAMES=
common:rbe_test_execution --test_env=CHIPS_PER_HOST_BOUNDS=
common:rbe_test_execution --test_env=HOST_BOUNDS=
common:rbe_test_execution --test_env=VBAR_CONTROL_SERVICE_URL=

# CI presubmit on Google Cloud RBE: CPU tests plus TPU tests that have an RBE
# pool. Today that's single-chip v5e (ct5lp-hightpu-1t). A test's pool follows
# its presubmit-v<N> tag, not its requires-tpu-* tags, so v6/v7 tests are left
# out by that tag and multi-chip v5 tests by their `:8`/`:4` tags. Tests that
# cannot run in the RBE container environment are tagged no-remote-exec.
#
# This repeats `ci` minus remote_execution_readwrite, whose platform would
# otherwise come ahead of rbe_platform in --extra_execution_platforms.
# rbe_test_execution comes after resultstore_base so its BES instance wins.
common:ci_rbe_presubmit --build_tests_only
common:ci_rbe_presubmit --config=resultstore_base
common:ci_rbe_presubmit --remote_download_minimal
common:ci_rbe_presubmit --keep_going
test:ci_rbe_presubmit --test_output=errors
common:ci_rbe_presubmit --color=yes
common:ci_rbe_presubmit --curses=no
common:ci_rbe_presubmit --config=rbe_test_execution
common:ci_rbe_presubmit --build_tag_filters=-nobuild,-requires-gpu,-cuda-build-test
common:ci_rbe_presubmit --test_tag_filters=-nobuild,-notest,-nopresubmit,-requires-gpu,-cuda-build-test,-presubmit-v6,-presubmit-v7,-requires-tpu-v5lite:4,-requires-tpu-v5lite:8,-requires-tpu-v5p:4,-no-remote-exec,-requires-newest-deps

# TPU wheel version extras for local default builds.
build --define WHEEL_VERSION_EXTRAS=

# Enable rules_python venv mode.
common --@rules_python//python/config_settings:bootstrap_impl=script
common --@rules_python//python/config_settings:venvs_site_packages=yes

# Config for testing wheel builds.
build --flag_alias=test_wheel=//:test_wheel

# The wheel is always the versioned, separated layout: route the XLA/MLIR
# backend through the torch_version-reset transition so it is built once around
# shared.
build:wheel_base --//:wheel_build=True

# Common config for all wheel.
build:wheel_common --config=remote_execution_readonly
build:wheel_common --config=wheel_base

# Nightly/postsubmit config for wheel builds. Uses a dedicated cache-silo-key
# platform to isolate nightly build artifacts from PR builds and release builds,
# preventing cross-pipeline cache contamination without command-line flag conflicts.
build:wheel_nightly --config=wheel_common
build:wheel_nightly --extra_execution_platforms="//bazel/platforms:rbe_wheel_nightly_platform"

# Release-channel wheel: wheel_common without the PyTorch-nightly glue. Use this
# for artifacts published to an index (the nightly glue is built against a
# transient dev snapshot and does not belong in a release). Uses a dedicated
# cache-silo-key platform so release artifacts are cached independently from
# nightly snapshots and test runs.
build:wheel_release --config=wheel_common
build:wheel_release --extra_execution_platforms="//bazel/platforms:rbe_wheel_release_platform"
build:wheel_release --//:include_nightly_glue=False

# Build against a locally provided PyTorch instead of the pip hubs. This is
# the only supported spelling of local-torch mode; typical use:
#
#   TORCH_SOURCE=/path/to/torch-*.whl bazel build --config=local_torch ...
#
# The TORCH_SOURCE env var points at the wheel (or source tree); @local_torch
# and rules_python both ingest it from there. The //shims/torch:local_torch
# flag this config sets is the single switch for the mode: every local-torch
# config_setting keys on it, and the glue version transition reads it to keep
# a local build in one torch configuration (a local build has exactly one
# torch, so the per-version glue configurations never fork).
build:local_torch --//shims/torch:local_torch=True

# Config for running on CUDA GPUs
common:cuda --//shims/torch:cuda_torch=True

# Common config for testing the wheel
common:wheel_common_test --config=wheel_base
test:wheel_common_test --test_output=errors
build:wheel_common_test --test_wheel=true
common:wheel_common_test --test_lang_filters=py  # Only run python tests

# Config for CPU wheel test.
common:wheel_test_cpu --config=ci_cpu
common:wheel_test_cpu --config=wheel_common_test
common:wheel_test_cpu --test_tag_filters=-nobuild,-notest,-nopresubmit,-requires-gpu,-requires-tpu,-wheel_test_excluded,-cuda-build-test,-requires-newest-deps

# Split wheel test configurations for presubmits
common:wheel_test_tpu_v5 --config=wheel_common_test
common:wheel_test_tpu_v5 --config=ci_tpu_v5

common:wheel_test_tpu_v6 --config=wheel_common_test
common:wheel_test_tpu_v6 --config=ci_tpu_v6

common:wheel_test_tpu_v7 --config=wheel_common_test
common:wheel_test_tpu_v7 --config=ci_tpu_v7

# Tag filters for split wheel test runs
# Tests are assigned exactly one mutually exclusive presubmit-v{N} tag.
# presubmit-v{N} must be the ONLY positive filter used here to prevent tests
# from running on the wrong hardware.
common:wheel_test_tpu_v5 --test_tag_filters=-notest,-nobuild,-nopresubmit,-wheel_test_excluded,-fails-on-tpu-v5,presubmit-v5,-requires-newest-deps
common:wheel_test_tpu_v6 --test_tag_filters=-notest,-nobuild,-nopresubmit,-wheel_test_excluded,-fails-on-tpu-v6,presubmit-v6,-requires-newest-deps
common:wheel_test_tpu_v7 --test_tag_filters=-notest,-nobuild,-nopresubmit,-wheel_test_excluded,-fails-on-tpu-v7,presubmit-v7,-requires-newest-deps

###############################################################################
# Allow per-user, project-specific bazelrc (gitignored).
# Keep this last so user options take precedence over everything above.
try-import %workspace%/user.bazelrc
