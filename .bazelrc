
# Show various config startup information to aid debugging.
common --announce_rc

# TODO: b/431034055 - XLA doesn't give visiblity to some pjrt targets.
# As a work around, disable visibility checking.
common --check_visibility=false

# The default comes form XLA's setup, which is 3.13,
# while we have 3.12 configured.
common --repo_env=HERMETIC_PYTHON_VERSION=3.12

common --enable_bzlmod=true --enable_workspace=false

# Config to enable legacy WORKSPACE. Use with --config=workspace.
common:workspace --enable_bzlmod=false
common:workspace --enable_workspace=true
# Support legacy WORKSPACE-style repository paths.
common:workspace --per_file_copt=external/(onednn|llvm-project)/.*[.](cc|cpp|hpp)$@-std=c++17

# Enable usage of pywrap rules for pybind_extension.
common --repo_env=USE_PYWRAP_RULES=1

# The XLA repo uses repository rules with remotable=True.
common --experimental_repo_remote_exec

# Disable Python output buffering so that, if C++ crashes the
# process, buffered output doesn't go missing (e.g. print
# statements for debugging).
common --test_env=PYTHONUNBUFFERED=1

common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --incompatible_strict_action_env=true

# Enable passing through TPU envvars by default for convenience.
common --config=tpu_envvars

# Needed for setting C++ standard to C++20.
common --enable_platform_specific_config

# Use C++20 by default, but not for `.c` files. Clang 18
# gives an error when C files use it.
common --per_file_copt=.*[.](cc|cpp|hpp)$@-std=c++20
# Use C++17 for dependencies incompatible with C++20.
# Since the last flag wins for a given file, this comes after
# the above flag.
# Support Bzlmod-style mangled repository paths.
common --per_file_copt=external/.*(onednn|llvm-project).*[.](cc|cpp|hpp)$@-std=c++17

# Treat warnings as errors.
build --copt=-Werror

# ===== Start spammy C++ compile warning disables =====
# Some low-level legacy glibc macros are used in lots of
# places, which very spammy, so silence this one.
build --per_file_copt=".*@-Wno-#pragma-messages"
build --per_file_copt=.*@-Wno-deprecated-declarations
# NOTE: Absl and Torch both define LOG, DCHECk, etc macros.
# The two are *usually* source-compatible, but aren't always,
# and it can manifest is weird ways in far away dependencies.
build --per_file_copt=.*@-Wno-macro-redefined
build --per_file_copt=.*@-Wno-defaulted-function-deleted
build --per_file_copt=.*@-Wno-unused-command-line-argument
build --host_copt=-Wno-unused-command-line-argument
build --linkopt=-Wno-unused-command-line-argument
build --host_linkopt=-Wno-unused-command-line-argument
build --per_file_copt=.*@-Wno-return-type

# Disable warnings from external dependencies for both the target product and
# the build-time host tools, which we can't do anything about and are very
# spammy.
# NOTE: Some warnings may be due to external dependencies, but
# get reported as originating from torch_tpu code. Those need
# to be ignored using a plain `.*` match.
build --per_file_copt=.*external/.*@-w
build --host_per_file_copt=.*external/.*@-w

# Disable warnings globally for both target and host builds.
# We do this because the following warnings occur from external dependencies
# (primarily OpenXLA, Abseil, and RE2) during the compilation of our local
# files, and `--per_file_copt=.*external.*@-w` and
# `build --host_per_file_copt=.*external/.*@-w` above cannot catch them.
# We accept the trade-off of losing these specific checks on our own code in
# order to prevent these third-party headers from causing massive log bloat and
# crashing the browser.
#
# To avoid massive spam from OpenXLA headers missing _Nonnull/_Nullable.
build --copt=-Wno-nullability-completeness
build --host_copt=-Wno-nullability-completeness
# To avoid spam from RE2/Abseil and OpenXLA headers using deprecated macros/locks.
build --copt=-Wno-deprecated-declarations
build --host_copt=-Wno-deprecated-declarations
# To avoid spam from third-party unused functions and variables.
build --copt=-Wno-unused-function
build --host_copt=-Wno-unused-function
build --copt=-Wno-unused-value
build --host_copt=-Wno-unused-value

# ===== End spammy C++ compile warning disables ===

# Set C++ standard to C++20.
# The clang wrapper inside rules_ml_toolchain uses a hardcoded sysroot of
# linux_glibc_2_27, which maps to c++17. We need to switch to linux_glibc_2_31
# to get C++20. See
# https://github.com/google-ml-infra/rules_ml_toolchain?tab=readme-ov-file#configure-the-llvm--sysroot-in-rules_ml_toolchain
# for details.
build --repo_env=LLVM_VERSION=20
build --repo_env=SYSROOT_DIST=linux_glibc_2_31
build --action_env=BAZEL_CXXOPTS="-std=c++20"

# The disk cache uses local disk as a "remote" cache backend, which can
# significantly speed up builds across server restarts and analysis cache
# wipes.
build --disk_cache=~/.cache/bazel/bazel-disk-cache
build --experimental_disk_cache_gc_max_age=90d
build --experimental_disk_cache_gc_max_size=100G

# Don't implicitly add repo roots to sys.path. This avoids top-level import
# name collisions.
# TODO: b/460162708 - This must be true because XNNPACK relies on its
# repo root being implicitly added to sys.path. Set this to false when
# XNNPACK is fixed.
build --experimental_python_import_all_repositories=true

# llvm has a bug where an empty glob isn't explicitly set.
build --incompatible_disallow_empty_glob=false
# Using the //... wildcard forces Bazel's loading phase to evaluate every single
# BUILD file in the entire repository. The flag prefixed with `build` above only
# allows Bazel to suppress the empty glob crashes from commands `bazel build` or
# `bazel test`. Once we introduce `bazel query` commands, Bazel will execute the
# glob check, hit the empty packages and instantly crash.
query --incompatible_disallow_empty_glob=false

# Disable magic generation of `__init__.py` files. This avoids surprising
# import behaviors that only happen under Bazel.
build --incompatible_default_to_explicit_init_py=true

# Don't duplicate all the external dependency filesrunfiles under
# $runfiles/external.
build --legacy_external_runfiles=false

# Get notified of file changes to rehash them before the next build.
build --watchfs

# Some targets have the same py source file, but use different
# configurations via `requires-` tags. This results in an action
# conflict when precompiling. Disable to avoid that problem.
build --@rules_python//python/config_settings:precompile=force_disabled

# NOTE: the --config=faster settings may make builds faster, but at the cost of
# weaker correctness. If builds act weird, run `bazel clean` and/or remove
# the `--config=faster` setting to help clear the Bazel state.

# By default, jobs==cores, but much work is IO bound, so can scale higher.
build:faster --jobs=HOST_CPUS*20
# Skip checking if an e.g. genrule output was changed manually.
build:faster --experimental_check_output_files=false
# Bazel 9 feature: skip checking files on the local host.
# build:faster --experimental_check_external_other_files=false

# ThreadSanitizer (TSan) Configurations
# Base TSan config for C++ tests.
common:tsan_cc --features=tsan
# Never strips debugging information from all binaries and shared libraries.
common:tsan_cc --strip=never
# Enables TSan to detect data races in C/C++ code at runtime.
common:tsan_cc --copt=-fsanitize=thread
common:tsan_cc --linkopt=-fsanitize=thread
# Generates DWARF debugging information so TSan prints filenames and line
# numbers.
common:tsan_cc --copt=-g
# Keeps frame pointers intact for fast, accurate stack unwinding in error
# reports.
common:tsan_cc --copt=-fno-omit-frame-pointer
# Defines a macro allowing developers to write `#ifdef THREAD_SANITIZER` in C++
# to selectively disable flaky code or use explicit TSan annotations.
common:tsan_cc --copt=-DTHREAD_SANITIZER
# TSan executes exceptionally slowly at -O0. -O1 applies basic optimizations to
# speed up execution without aggressively inlining and destroying the call stack
# structure.
common:tsan_cc --copt=-O1

# TSan config for Python tests.
# Explicitly uses dynamic linking (-shared-libsan) so the PyTorch C++ extension
# leaves its TSan symbols undefined, allowing our LD_PRELOAD wrapper to satisfy
# them at runtime via the custom Python interpreter.
common:tsan_py --config=tsan_cc
common:tsan_py --copt=-shared-libsan
common:tsan_py --linkopt=-shared-libsan
# Hermetic Python Configuration for TSan (Python 3.12)
# Standard Python generates thousands of false-positive data races due to the
# GIL. This overrides the default rules_ml_toolchain behavior to fetch a custom
# Python interpreter built natively with LLVM 20 TSan instrumentation.
common:tsan_py --repo_env=HERMETIC_PYTHON_VERSION=3.12
common:tsan_py --repo_env=HERMETIC_PYTHON_URL=https://storage.googleapis.com/ml-sysroot-testing/python/cpython-3.12.x-tsan-shared-linux-x86_64-llvm-20-bazel-20260511.tar.gz
common:tsan_py --repo_env=HERMETIC_PYTHON_SHA256=91db187fb5d98e6361b6416e81a6037dbe5ba745dc3e191ba1ffa06a3108e1b6
common:tsan_py --repo_env=HERMETIC_PYTHON_PREFIX=cpython-3.12.x-tsan-shared-linux-x86_64-llvm-20-bazel-20260511/

# Config to aid debugging.
# "standalone" means "local" -- run things locally so its easier to
# inspect state and break out of bazel sandboxes.
common:local --test_strategy=standalone
common:local --spawn_strategy=standalone
common:local --strategy=standalone

# Config for no_remote builds
common:no_rbe --config=local
common:no_rbe --remote_cache=
common:no_rbe --remote_executor=
common:no_rbe --google_default_credentials=false

# Useful when running a single test target and/or test
# case within the test.
common:testone --config=local
common:testone --test_output=streamed

# Config for when TPU is the target platform.
common:tpu_envvars --test_env=TPU_SKIP_MDS_QUERY
common:tpu_envvars --test_env=TPU_TOPOLOGY
common:tpu_envvars --test_env=TPU_WORKER_ID
common:tpu_envvars --test_env=TPU_TOPOLOGY_WRAP
common:tpu_envvars --test_env=TPU_CHIPS_PER_HOST_BOUNDS
common:tpu_envvars --test_env=TPU_ACCELERATOR_TYPE
common:tpu_envvars --test_env=TPU_RUNTIME_METRICS_PORTS
common:tpu_envvars --test_env=TPU_TOPOLOGY_ALT
common:tpu_envvars --test_env=TPU_HOST_BOUNDS
common:tpu_envvars --test_env=TPU_WORKER_HOSTNAMES
common:tpu_envvars --test_env=CHIPS_PER_HOST_BOUNDS
common:tpu_envvars --test_env=HOST_BOUNDS
# NOTE: This value can be host-specific and harmful to Bazel caching.
common:tpu_envvars --test_env=VBAR_CONTROL_SERVICE_URL

# Configs for Bazel remote caching.
# These are split into read-only and read-write configs for security.
# Only CI (or other trusted accounts) have write access to the cache to prevent
# it from being *directly* poisoned/corrupted by untrusted users (a malicious PR
# triggers CI could still do so, however).
#
# However, we still want users to benefit from remote caching, so a read-only
# config is enabled by default.
#
# See https://developers.google.com/remote-build-execution/docs/set-up/set-up-caching
# for more details.
common:remote_caching_readonly --remote_upload_local_results=false
common:remote_caching_readonly --remote_cache=grpcs://remotebuildexecution.googleapis.com
common:remote_caching_readonly --remote_instance_name=projects/ml-oss-rbe-testing/instances/default_instance
common:remote_caching_readonly --remote_default_exec_properties=cache-silo-key=FirstCachedBuild
common:remote_caching_readonly --google_default_credentials

# Allow creation of resultstore URLs for ci bazel invocation, must be used in
# conjunction with an RBE or RBE cache write config.
common:resultstore_base --bes_backend=buildeventservice.googleapis.com
common:resultstore_base --bes_timeout=600s
common:resultstore_base --bes_results_url="https://source.cloud.google.com/results/invocations"
common:resultstore_base --bes_instance_name="ml-oss-rbe-testing"

common:remote_caching_readwrite --config=remote_caching_readonly
common:remote_caching_readwrite --remote_upload_local_results=true

common:remote_execution_readwrite --config=remote_execution_readonly
common:remote_execution_readwrite --remote_upload_local_results=true

# Configs for Bazel public caching.
common:public_caching_readonly --remote_upload_local_results=false
common:public_caching_readonly --remote_cache="https://storage.googleapis.com/torchtpu-bazel-cache/"

common:public_caching_readwrite --config=public_caching_readonly
common:public_caching_readwrite --remote_upload_local_results=true
common:public_caching_readwrite --google_default_credentials

# Configs for Bazel public caching for PyTorch/Helion.
common:helion_public_caching_readonly --remote_upload_local_results=false
common:helion_public_caching_readonly --remote_cache="https://storage.googleapis.com/torchtpu-bazel-cache-helion/"

common:helion_public_caching_readwrite --config=helion_public_caching_readonly
common:helion_public_caching_readwrite --remote_upload_local_results=true
common:helion_public_caching_readwrite --google_default_credentials

# Settings specific to CI runs.
common:ci --build_tests_only
common:ci --config=remote_execution_readwrite
common:ci --config=resultstore_base
common:ci --remote_download_minimal
common:ci --keep_going
test:ci --test_output=errors

# Setting specific to benchmarking runs.
common:bench --config=ci
common:bench --spawn_strategy=standalone,local

# Settings specific to CPU CI runs.
common:ci_cpu --config=ci
common:ci_cpu --build_tag_filters=-nobuild,-requires-gpu,-requires-tpu
common:ci_cpu --test_tag_filters=-nobuild,-notest,-requires-gpu,-requires-tpu

# Settings specific to CPU presubmit.
common:ci_cpu_presubmit --config=ci_cpu
common:ci_cpu_presubmit --test_tag_filters=-nobuild,-notest,-requires-gpu,-requires-tpu,-nopresubmit

# Settings specific to TPU CI runs.
common:ci_tpu_base --config=ci
common:ci_tpu_base --build_tag_filters=-nobuild,requires-tpu-v5lite,requires-tpu-v5lite:8,requires-tpu-v5p,requires-tpu-v5p:4
common:ci_tpu_base --spawn_strategy=standalone,local

# Settings for presubmit and postsubmit on TPU v5.
common:ci_tpu --config=ci_tpu_base
common:ci_tpu --test_tag_filters=requires-tpu,-notest,-nobuild,-nopresubmit

# Settings for presubmit and postsubmit on TPU v6.
common:ci_tpu_on_v6 --config=ci_tpu_base
common:ci_tpu_on_v6 --test_tag_filters=requires-tpu,-notest,-nobuild,-nopresubmit,-fails-on-tpu-v6

# Settings for presubmit and postsubmit on TPU v7.
common:ci_tpu_on_v7 --config=ci_tpu_base
common:ci_tpu_on_v7 --test_tag_filters=requires-tpu,-notest,-nobuild,-nopresubmit,-fails-on-tpu-v7
common:ci_tpu_on_v7 --local_test_jobs=1
# Bypass the libtpu multi-process lock. Otherwise, we have to explicitly delete
# /tmp/libtpu_lockfile to clean up the dirty state of previous crashed jobs to
# unblock the current job.
common:ci_tpu_on_v7 --test_env=ALLOW_MULTIPLE_LIBTPU_LOAD=true

# Settings for nightly runs on TPU.
common:ci_tpu_nightly --config=ci_tpu_base
common:ci_tpu_nightly --test_tag_filters=requires-tpu,-notest,-nobuild,-nonightly

# Setting TPU support true for profiler trace.
build --define=with_tpu_support=true

# Configs for Bazel remote execution.
# Do not use instance "projects/ml-oss-rbe-testing/instances/default_instance"
# because it does not have RBE agents setup.
common:remote_execution_readonly --remote_instance_name=projects/tensorflow-testing/instances/default_instance
common:remote_execution_readonly --google_default_credentials
common:remote_execution_readonly --jobs=200
common:remote_execution_readonly --remote_timeout=3600
common:remote_execution_readonly --test_timeout=3600
# This define is probably vestigial, but it's not entirely clear.
# Revisit removing this with Bazel 9.
common:remote_execution_readonly --define=EXECUTOR=remote
common:remote_execution_readonly --remote_executor=grpcs://remotebuildexecution.googleapis.com
common:remote_execution_readonly --extra_execution_platforms="@ml_build_config_platform//:platform"

# Allow per-user, project-specific bazelrc.
# Do this last so it takes precedence.
try-import %workspace%/user.bazelrc

# TPU wheel version extras for local default builds.
build --define WHEEL_VERSION_EXTRAS=

# Enable rules_python venv mode.
common --@rules_python//python/config_settings:bootstrap_impl=script
common --@rules_python//python/config_settings:venvs_site_packages=yes

# Config for testing wheel builds.
build --flag_alias=test_wheel=//:test_wheel

# Common config for all wheel.
build:wheel_common --config=remote_caching_readonly
build:wheel_common --config=remote_execution_readonly


# Common config for testing the wheel
test:wheel_common_test --config=wheel_common
test:wheel_common_test --test_output=errors
test:wheel_common_test --test_wheel=true
test:wheel_common_test --test_lang_filters=py  # Only run python tests

# Config for testing CPU wheel test.
test:wheel_test_cpu --config=ci_cpu
test:wheel_test_cpu --config=wheel_common_test

# Config for testing TPU wheel test.
test:wheel_test_tpu --config=ci_tpu
test:wheel_test_tpu --config=wheel_common_test
test:wheel_test_tpu --spawn_strategy=local

# We need to re-specify all of these tag filters because when specified more
# than once, they don't compose and we want to be able to also exclude
# wheel_test_excluded
test:wheel_test_cpu --test_tag_filters=-nobuild,-notest,-requires-gpu,-requires-tpu,-wheel_test_excluded

# Settings for wheel test on TPU v5.
test:wheel_test_tpu --test_tag_filters=requires-tpu,-notest,-nobuild,-nopresubmit,-wheel_test_excluded

# Settings for wheel test on TPU v6.
test:wheel_test_tpu_on_v6 --config=wheel_test_tpu
test:wheel_test_tpu_on_v6 --test_tag_filters=requires-tpu,-notest,-nobuild,-nopresubmit,-wheel_test_excluded,-fails-on-tpu-v6

# Settings for wheel test on TPU v7.
test:wheel_test_tpu_on_v7 --config=wheel_test_tpu
test:wheel_test_tpu_on_v7 --test_tag_filters=requires-tpu,-notest,-nobuild,-nopresubmit,-wheel_test_excluded,-fails-on-tpu-v7
test:wheel_test_tpu_on_v7 --local_test_jobs=4
test:wheel_test_tpu_on_v7 --test_env=ALLOW_MULTIPLE_LIBTPU_LOAD=true
